{
  "description": "Codex lifecycle hooks: SessionStart, PreCompact and SessionEnd run the shared lifecycle scripts. The pr-watch entries (SessionStart, PreToolUse and PostToolUse on Bash or create_pull_request, Stop) are the opt-in PR watch: they exit at once unless ~/.ytstack/config has pr_watch=on (docs/pr-watch.md).",
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume|clear|compact",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"${PLUGIN_ROOT}/bin/ytstack-codex\" hook session-start",
            "timeout": 10,
            "additionalContextLimit": 5000
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash \"${PLUGIN_ROOT}/bin/ytstack-codex\" hook pr-watch",
            "timeout": 15
          }
        ]
      }
    ],
    "PreCompact": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash \"${PLUGIN_ROOT}/bin/ytstack-codex\" hook pre-compact",
            "timeout": 5
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash \"${PLUGIN_ROOT}/bin/ytstack-codex\" hook session-end",
            "timeout": 3
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash|.*create_pull_request.*",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"${PLUGIN_ROOT}/bin/ytstack-codex\" hook pr-watch",
            "timeout": 15
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Bash|.*create_pull_request.*",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"${PLUGIN_ROOT}/bin/ytstack-codex\" hook pr-watch",
            "timeout": 15
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash \"${PLUGIN_ROOT}/bin/ytstack-codex\" hook pr-watch",
            "timeout": 15
          }
        ]
      }
    ]
  }
}

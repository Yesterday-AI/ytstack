{
  "description": "Codex lifecycle hooks. Only the three supported lifecycle events are registered.",
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume|clear|compact",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"${PLUGIN_ROOT}/bin/ytstack-codex\" hook session-start",
            "timeout": 10,
            "additionalContextLimit": 5000
          }
        ]
      }
    ],
    "PreCompact": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash \"${PLUGIN_ROOT}/bin/ytstack-codex\" hook pre-compact",
            "timeout": 5
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash \"${PLUGIN_ROOT}/bin/ytstack-codex\" hook session-end",
            "timeout": 3
          }
        ]
      }
    ]
  }
}

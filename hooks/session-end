#!/usr/bin/env bash
# ytstack SessionEnd hook
#
# Fires when Claude Code ends the session. Appends a journal entry with
# end-of-session marker. Does NOT mutate STATE.md -- that file is a tracked
# source-of-truth Markdown, written deliberately by skills as part of state
# transitions. A hook firing on every session end has no business writing to
# it (creates phantom diffs on every git status).
#
# Side-effects only. Does not emit stdout context.

set -uo pipefail

# Capture stdin immediately -- Claude Code delivers the hook payload (including
# session_id) on stdin JSON. Must read before any subcommand consumes stdin.
# There is no CLAUDE_SESSION_ID env var; session_id lives only in this payload.
INPUT=$(cat)

PROJECT_DIR="${CLAUDE_PROJECT_DIR:-$PWD}"
cd "$PROJECT_DIR" 2>/dev/null || exit 0

YT_DIR=""
if [ -d "$PROJECT_DIR/.ytstack" ]; then
  YT_DIR="$PROJECT_DIR/.ytstack"
else
  SLUG=$(basename "$(git rev-parse --show-toplevel 2>/dev/null || echo "$PROJECT_DIR")")
  USER_YT="$HOME/.ytstack/projects/$SLUG"
  [ -d "$USER_YT" ] && YT_DIR="$USER_YT"
fi

[ -z "$YT_DIR" ] && exit 0

STATE_FILE="$YT_DIR/STATE.md"
JOURNAL_DIR="$YT_DIR/journal"
TS=$(date -u +"%Y-%m-%dT%H:%M:%SZ")

# Append to journal (persistent log of sessions)
mkdir -p "$JOURNAL_DIR"
JOURNAL_FILE="$JOURNAL_DIR/sessions.jsonl"

get_field() { sed -n "s/^$1: *//p" "$STATE_FILE" 2>/dev/null | head -1; }
CURRENT_MILESTONE=$(get_field current_milestone)
ACTIVE_SLICE=$(get_field active_slice)
ACTIVE_TASK=$(get_field active_task)

# Extract session_id from the stdin payload captured above.
# session_id arrives only on stdin JSON -- there is no CLAUDE_SESSION_ID env var.
if command -v jq >/dev/null 2>&1; then
  SESSION_ID=$(printf '%s' "$INPUT" | jq -r '.session_id // "unknown"' 2>/dev/null || echo "unknown")
else
  SESSION_ID=$(printf '%s' "$INPUT" | python3 -c "import sys,json; d=json.load(sys.stdin); print(d.get('session_id','unknown'))" 2>/dev/null || echo "unknown")
fi

# Build JSONL entry. Prefer jq for safe encoding; fall back to python3.
if command -v jq >/dev/null 2>&1; then
  jq -nc \
    --arg ts "$TS" \
    --arg event "session-end" \
    --arg milestone "${CURRENT_MILESTONE:-none}" \
    --arg slice "${ACTIVE_SLICE:-none}" \
    --arg task "${ACTIVE_TASK:-none}" \
    --arg session_id "$SESSION_ID" \
    '{timestamp: $ts, event: $event, milestone: $milestone, slice: $slice, task: $task, session_id: $session_id}' \
    >> "$JOURNAL_FILE"
elif command -v python3 >/dev/null 2>&1; then
  python3 -c "
import json
print(json.dumps({
  'timestamp': '$TS',
  'event': 'session-end',
  'milestone': '${CURRENT_MILESTONE:-none}',
  'slice': '${ACTIVE_SLICE:-none}',
  'task': '${ACTIVE_TASK:-none}',
  'session_id': '$SESSION_ID'
}))
" >> "$JOURNAL_FILE"
fi

exit 0

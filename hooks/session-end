#!/usr/bin/env bash
# ytstack SessionEnd hook
#
# Appends ONE JSON line per session end to the out-of-tree, per-session file
#   <state>/repos/<repo-key>/worktrees/<wt-key>/sessions/<session_id>/session.jsonl
#
# It never writes into the checkout (no `.ytstack/journal/`, no STATE.md): a
# hook firing on every session end has no business dirtying a tracked tree
# (issues #21, #26, #27; DECISIONS 2026-11-07). Per-session files make the
# journal single-writer, so no locking is needed (macOS has no flock).
#
# Budget: Claude Code gives SessionEnd hooks 1.5 s by default. Besides the
# lib's context resolution (a few `git rev-parse`), this hook runs no
# subprocess except an optional `jq` for the `reason` field; the JSON line is
# built with printf and sed escaping.
#
# Fail-open: exit 0 always, problems to stderr.

set -uo pipefail
trap '' PIPE

. "$(cd "$(dirname "$0")" && pwd)/lib/git-ctx.sh"

yt_read_stdin
yt_git_ctx "${YT_CWD:-$PWD}"
YT_DIR=$(yt_resolve_yt_dir)
[ -z "$YT_DIR" ] && exit 0

STATE_FILE="$YT_DIR/STATE.md"
get_field() { sed -n "s/^$1: *//p" "$STATE_FILE" 2>/dev/null | head -1; }
PROJECT=$(get_field project)
CURRENT_MILESTONE=$(get_field current_milestone)
ACTIVE_SLICE=$(get_field active_slice)
ACTIVE_TASK=$(get_field active_task)

REASON="${YT_REASON:-}"

# Minimal JSON string escaping: backslash, double quote, tab, CR, LF.
jstr() {
  printf '%s' "$1" | sed -e 's/\\/\\\\/g' -e 's/"/\\"/g' -e 's/	/\\t/g' -e 's/\r/\\r/g' | tr '\n' ' '
}

TS=$(date -u +"%Y-%m-%dT%H:%M:%SZ")
SESS_DIR=$(yt_state_dir)
JOURNAL="$SESS_DIR/session.jsonl"

printf '{"timestamp":"%s","event":"session-end","reason":"%s","session_id":"%s","project":"%s","milestone":"%s","slice":"%s","task":"%s","worktree":"%s","linked_worktree":"%s"}\n' \
  "$TS" \
  "$(jstr "${REASON:-unknown}")" \
  "$(jstr "${YT_SESSION_ID:-nosession}")" \
  "$(jstr "${PROJECT:-unknown}")" \
  "$(jstr "${CURRENT_MILESTONE:-none}")" \
  "$(jstr "${ACTIVE_SLICE:-none}")" \
  "$(jstr "${ACTIVE_TASK:-none}")" \
  "$(jstr "$YT_TOPLEVEL")" \
  "$YT_IS_LINKED" \
  >> "$JOURNAL" 2>/dev/null || echo "[ytstack session-end] could not append to $JOURNAL" >&2

exit 0

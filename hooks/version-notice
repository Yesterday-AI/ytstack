#!/usr/bin/env bash
# ytstack UserPromptSubmit hook: tell a session once when the installed plugin
# is newer than the one it loaded (M031-S03, issue #61). A session keeps the
# skill text it loaded; after an update it follows the old text until the
# skills are invoked again.
#
#   1. The first prompt of a session records the version of the plugin root
#      this hook runs from (CLAUDE_PLUGIN_ROOT) in
#      <state base>/sessions/<session id>/plugin-version. The file is keyed by
#      the session only, not by the checkout, so a session that moves into a
#      worktree keeps it. SessionStart stays read-only (DECISIONS 2026-11-15).
#   2. Every prompt compares the recorded version with the installed one:
#      installPath of the ytstack entries in installed_plugins.json
#      (${CLAUDE_CONFIG_DIR:-~/.claude}/plugins) of this root's marketplace,
#      scope user or project/local for this session's project, else the
#      newest sibling of this plugin root in the plugin cache without an
#      .orphaned_at marker, else this root. Newer: one notice line plus one
#      line with the entry titles of the installed CHANGELOG.md between the
#      two versions (bounded); once it is printed a marker notified-<version>,
#      so each installed version is said once.
#
# Local files only, no network. Fail open: any problem ends silent with exit 0.
# Output: the UserPromptSubmit additionalContext JSON; YTSTACK_HOOK_FORMAT=plain
# prints the text.

set -uo pipefail
trap '' PIPE

. "$(cd "$(dirname "$0")" && pwd)/lib/git-ctx.sh"

yt_read_stdin
SID="${YT_SESSION_ID:-}"
case "$SID" in ''|.|..|*[!A-Za-z0-9._-]*) exit 0 ;; esac
ROOT="${CLAUDE_PLUGIN_ROOT:-$(cd "$(dirname "$0")/.." && pwd)}"

# version_of <plugin root> -> the "version" of its manifest ("" when none).
version_of() {
  local m
  for m in "$1/.claude-plugin/plugin.json" "$1/.codex-plugin/plugin.json"; do
    [ -f "$m" ] || continue
    sed -n 's/^[[:space:]]*"version"[[:space:]]*:[[:space:]]*"\([^"]*\)".*/\1/p' "$m" | head -1
    return 0
  done
}
# newer <a> <b>: true when version a is above b (numeric major.minor.patch;
# a suffix after "-" or "+" is ignored).
newer() {
  awk -v a="$1" -v b="$2" 'BEGIN {
    sub(/[-+].*/, "", a); sub(/[-+].*/, "", b)
    na = split(a, x, "."); nb = split(b, y, ".")
    for (i = 1; i <= 3; i++) { p = (i <= na) ? x[i] + 0 : 0; q = (i <= nb) ? y[i] + 0 : 0; if (p != q) exit !(p > q) }
    exit 1
  }'
}
# best <roots, one per line> -> the root with the highest version.
best() {
  local r v top="" topv=""
  while IFS= read -r r; do
    [ -n "$r" ] && [ -d "$r" ] || continue
    v=$(version_of "$r"); [ -n "$v" ] || continue
    if [ -z "$topv" ] || newer "$v" "$topv"; then top="$r"; topv="$v"; fi
  done
  printf '%s' "$top"
}

OWN=$(version_of "$ROOT")
[ -n "$OWN" ] || exit 0
DIR="$(yt_state_base)/sessions/$SID"
mkdir -p "$DIR" 2>/dev/null || exit 0
REC="$DIR/plugin-version"
if [ ! -s "$REC" ]; then
  printf '%s\n' "$OWN" > "$REC.$$" 2>/dev/null && mv -f "$REC.$$" "$REC" 2>/dev/null || exit 0
fi
LOADED=$(head -1 "$REC" 2>/dev/null)
[ -n "$LOADED" ] || exit 0

INST_ROOT=""
CFG="${CLAUDE_CONFIG_DIR:-$HOME/.claude}/plugins/installed_plugins.json"
# The marketplace this root came from (cache layout <marketplace>/ytstack*/<version>;
# empty outside the cache: any marketplace) and the project of the session: an
# entry counts when its scope is user (or none), or project/local for this
# project (its checkout or the main checkout of its worktree).
MKT=""
case "$(basename "$(dirname "$ROOT")")" in ytstack*) MKT=$(basename "$(dirname "$(dirname "$ROOT")")") ;; esac
PROJ="" PROJ_MAIN=""
if [ -n "${YT_CWD:-}" ] && [ -d "$YT_CWD" ]; then
  PROJ=$(git -C "$YT_CWD" rev-parse --show-toplevel 2>/dev/null) || PROJ=$(cd "$YT_CWD" && pwd -P)
  PROJ_MAIN=$(git -C "$YT_CWD" rev-parse --path-format=absolute --git-common-dir 2>/dev/null) && PROJ_MAIN=$(dirname "$PROJ_MAIN")
fi
if [ -f "$CFG" ]; then
  JQ=$(yt_jq)
  if [ -n "$JQ" ]; then
    PATHS=$("$JQ" -r --arg mkt "$MKT" --arg p1 "$PROJ" --arg p2 "$PROJ_MAIN" '(.plugins // {}) | to_entries[]
      | select((.key | split("@")) as $k | $k[0] == "ytstack" and ($mkt == "" or ($k[1] // "") == $mkt))
      | .value | (if type == "array" then .[] else . end) | objects
      | select((.scope // "user") == "user"
          or (((.scope == "project") or (.scope == "local")) and (.projectPath // "") != ""
              and ((.projectPath | rtrimstr("/")) == $p1 or (.projectPath | rtrimstr("/")) == $p2)))
      | .installPath // empty' "$CFG" 2>/dev/null)
  elif [ -n "$(yt_python)" ]; then
    PATHS=$("$(yt_python)" -I -c '
import json, sys
mkt, projects = sys.argv[2], {p for p in sys.argv[3:5] if p}
try:
    p = json.load(open(sys.argv[1])).get("plugins", {})
except Exception:
    p = {}
for k, v in p.items():
    name, _, market = k.partition("@")
    if name != "ytstack" or (mkt and market != mkt):
        continue
    for i in v if isinstance(v, list) else [v]:
        if not isinstance(i, dict) or not i.get("installPath"):
            continue
        scope = i.get("scope", "user")
        if scope == "user" or (scope in ("project", "local") and str(i.get("projectPath", "")).rstrip("/") in projects):
            print(i["installPath"])
' "$CFG" "$MKT" "$PROJ" "$PROJ_MAIN" 2>/dev/null)
  else
    PATHS=""
  fi
  INST_ROOT=$(printf '%s\n' "$PATHS" | best)
fi
if [ -z "$INST_ROOT" ]; then
  PARENT=$(dirname "$ROOT")
  case "$(basename "$PARENT")" in
    ytstack*)
      INST_ROOT=$(for d in "$PARENT"/*; do [ -d "$d" ] && [ ! -e "$d/.orphaned_at" ] && printf '%s\n' "$d"; done | best) ;;
  esac
fi
[ -n "$INST_ROOT" ] || INST_ROOT="$ROOT"
INST=$(version_of "$INST_ROOT")
[ -n "$INST" ] || exit 0
newer "$INST" "$LOADED" || exit 0
MARK="$DIR/notified-$INST"
case "$INST" in *[!A-Za-z0-9._+-]*) exit 0 ;; esac
[ ! -e "$MARK" ] || exit 0

TEXT="ytstack $INST installed, this session loaded $LOADED: reload the skills you use (invoke them again through the Skill tool; the skill text in this session is the old one)."
if [ -f "$INST_ROOT/CHANGELOG.md" ]; then
  CHANGES=$(awk -v lo="$LOADED" -v hi="$INST" -v max=600 -v file="$INST_ROOT/CHANGELOG.md" '
    function num(v, i,   x, n) { sub(/[-+].*/, "", v); n = split(v, x, "."); return (i <= n) ? x[i] + 0 : 0 }
    function gt(a, b,   i) { for (i = 1; i <= 3; i++) if (num(a, i) != num(b, i)) return num(a, i) > num(b, i); return 0 }
    function flush() { if (cur != "" && titles != "") add(cur ": " titles); titles = "" }
    function add(s) {
      if (cut) return
      if (length(out) + length(s) + 2 > max) { cut = 1; return }
      out = (out == "" ? s : out ". " s)
    }
    /^## \[/ {
      flush()
      v = $0; sub(/^## \[/, "", v); sub(/\].*/, "", v)
      cur = (v ~ /^[0-9]/ && gt(v, lo) && !gt(v, hi)) ? v : ""
      next
    }
    cur != "" && /^- \*\*/ {
      t = $0; sub(/^- \*\*/, "", t); sub(/\*\*.*/, "", t); sub(/[.:]+$/, "", t)
      titles = (titles == "" ? t : titles "; " t)
    }
    END {
      flush()
      if (out == "") exit
      print "What changed (" file "): " out (cut ? ". ... more in the file." : ".")
    }' "$INST_ROOT/CHANGELOG.md")
  [ -z "$CHANGES" ] || TEXT="$TEXT
$CHANGES"
fi

# The marker follows the printed notice: a notice that could not be produced
# or printed is said on the next prompt.
if [ "${YTSTACK_HOOK_FORMAT:-json}" = plain ]; then
  OUTPUT="$TEXT"
else
  JQ=$(yt_jq)
  if [ -n "$JQ" ]; then
    OUTPUT=$(printf '%s' "$TEXT" | "$JQ" -Rs '{hookSpecificOutput: {hookEventName: "UserPromptSubmit", additionalContext: .}}') || exit 0
  elif [ -n "$(yt_python)" ]; then
    OUTPUT=$(printf '%s' "$TEXT" | "$(yt_python)" -I -c 'import sys, json; print(json.dumps({"hookSpecificOutput": {"hookEventName": "UserPromptSubmit", "additionalContext": sys.stdin.read()}}))') || exit 0
  else
    exit 0
  fi
fi
[ -n "$OUTPUT" ] || exit 0
printf '%s\n' "$OUTPUT" 2>/dev/null || exit 0
: > "$MARK" 2>/dev/null
exit 0

#!/usr/bin/env bash
# ytstack SessionStart hook
#
# Injects two things as additionalContext:
#
#   1. The full content of skills/using-ytstack/SKILL.md -- the directive that
#      tells the agent to auto-invoke ytstack skills based on user intent
#      (superpowers-style proactive skill selection).
#
#   2. The current project state from .ytstack/STATE.md -- so the agent knows
#      where we are in the milestone/slice/task hierarchy -- plus pointers to
#      the user-written HANDOFF.md and the latest automatic (out-of-tree)
#      handoff written by the pre-compact hook.
#
# Resolution: payload `cwd` -> hooks/lib/git-ctx.sh (never CLAUDE_PROJECT_DIR,
# which is pinned to the session-start dir and does not follow worktrees;
# DECISIONS 2026-11-07). Read-only: writes nothing anywhere.
#
# Claude Code caps SessionStart additionalContext at 10,000 characters; the
# hook measures its output and drops the Next-action excerpt first if needed.

set -uo pipefail
trap '' PIPE

. "$(cd "$(dirname "$0")" && pwd)/lib/git-ctx.sh"

yt_read_stdin
yt_git_ctx "${YT_CWD:-$PWD}"
yt_resolve_yt_dir >/dev/null    # sets YT_DIR + YT_SCOPE (project|user|none) in this shell

STATE_FILE="${YT_DIR:+$YT_DIR/STATE.md}"

# Load the using-ytstack directive (source-of-truth lives in the plugin).
# Injected on EVERY session start where the plugin is active -- including
# greenfield sessions with no .ytstack/ yet, because the directive's job is to
# route greenfield build-intent to office-hours BEFORE any infra exists.
PLUGIN_ROOT="${CLAUDE_PLUGIN_ROOT:-$(cd "$(dirname "$0")/.." && pwd)}"
USING_YTSTACK_FILE="$PLUGIN_ROOT/skills/using-ytstack/SKILL.md"
USING_YTSTACK_CONTENT=""
if [ -f "$USING_YTSTACK_FILE" ]; then
  USING_YTSTACK_CONTENT=$(cat "$USING_YTSTACK_FILE")
  if [ -n "${YTSTACK_HOST_CONTEXT:-}" ]; then
    USING_YTSTACK_CONTENT="$YTSTACK_HOST_CONTEXT

$USING_YTSTACK_CONTENT"
  fi
fi

# The only no-op case: we cannot prime the agent if the directive is missing.
[ -z "$USING_YTSTACK_CONTENT" ] && exit 0

# Helper: emit additionalContext JSON with the given string
emit_json() {
  local content="$1" jq_bin py_bin
  jq_bin=$(yt_jq); py_bin=$(yt_python)
  if [ -n "$jq_bin" ]; then
    printf '%s' "$content" | "$jq_bin" -Rs '{hookSpecificOutput: {hookEventName: "SessionStart", additionalContext: .}}'
  elif [ -n "$py_bin" ]; then
    printf '%s' "$content" | "$py_bin" -I -c 'import sys, json; print(json.dumps({"hookSpecificOutput": {"hookEventName": "SessionStart", "additionalContext": sys.stdin.read()}}))'
  else
    # Last-resort raw -- won't safely handle embedded quotes/newlines
    printf '{"hookSpecificOutput":{"hookEventName":"SessionStart","additionalContext":"%s"}}\n' "$content"
  fi
}

DIRECTIVE="<EXTREMELY_IMPORTANT>
You have ytstack. Below is the full content of your 'ytstack:using-ytstack' skill, which tells you how to find and invoke ytstack skills based on user intent. Follow it. For all other skills, use the 'Skill' tool:

$USING_YTSTACK_CONTENT
</EXTREMELY_IMPORTANT>"

# Greenfield: no .ytstack/ exists for this checkout. An existing, documented
# codebase (README, docs/, CHANGELOG, ADRs, commit history; M010 / issue #18)
# is told apart by the shared detector so build-intent routes to
# adopt-brownfield instead of the office-hours pitch.
if [ -z "$YT_DIR" ]; then
  yt_brownfield_signals "$YT_TOPLEVEL"
  if [ "${YT_BROWNFIELD_SIGNALS:-0}" -ge 2 ]; then
    BF_SOURCES=$(printf '%s\n' "$YT_BROWNFIELD_HINTS" | sed 's/ ->.*//' | paste -sd, - | sed 's/,/, /g')
    GREENFIELD_STATE="[ytstack active -- scope: greenfield (existing codebase, no .ytstack/)]

No \`.ytstack/\` directory in $YT_TOPLEVEL, but this looks like an existing codebase ($YT_BROWNFIELD_SIGNALS brownfield signals: $BF_SOURCES).

For build-intent, work requests or \"set up ytstack here\": invoke \`ytstack:adopt-brownfield\` FIRST, not office-hours. It links the existing docs into \`.ytstack/\`, maps the codebase, and scaffolds only the gaps; the shipped track record is the validation. Do NOT invoke init-project (it would route here anyway) and do NOT run the office-hours pitch on an existing product. Reserve \`ytstack:office-hours\` for genuinely new scope the user describes as a new idea."
  else
    GREENFIELD_STATE="[ytstack active -- scope: greenfield]

No \`.ytstack/\` directory in $YT_TOPLEVEL (or any parent). This is greenfield.

Greenfield flow per the using-ytstack directive above:
1. If the user expresses build-intent (\"baue mir X\", \"build me X\", \"new project\", \"I have an idea\"), invoke \`ytstack:office-hours\` FIRST to validate the pitch. Do NOT invoke plan-milestone or init-project directly.
2. After office-hours produces OFFICE-HOURS.md, invoke \`ytstack:plan-ceo-review\` (concept mode) to stress-test premise + scope.
3. Optionally \`ytstack:plan-eng-review\` (concept mode) for feasibility.
4. Then \`ytstack:init-project\` to scaffold \`.ytstack/\` (populates PROJECT.md from the pitch, no cold PM questions).
Existing codebase with its own README/docs but no \`.ytstack/\`? Use \`ytstack:adopt-brownfield\` instead of the pitch."
  fi

  emit_json "$DIRECTIVE

---

$GREENFIELD_STATE"
  exit 0
fi

# Brownfield: .ytstack/ exists. Handle missing STATE.md as anomaly.
if [ ! -f "$STATE_FILE" ]; then
  emit_json "$DIRECTIVE

---

[ytstack] $YT_DIR exists but STATE.md is missing. Run /ytstack:init-project to repair, or remove the directory."
  exit 0
fi

# Extract frontmatter fields from STATE.md
get_field() { sed -n "s/^$1: *//p" "$STATE_FILE" | head -1; }
PROJECT=$(get_field project)
CURRENT_MILESTONE=$(get_field current_milestone)
ACTIVE_SLICE=$(get_field active_slice)
ACTIVE_TASK=$(get_field active_task)
LAST_UPDATED=$(get_field last_updated)

# "Next action" body (up to the next ## header), trimmed
NEXT_ACTION=$(awk '/^## Next action/{flag=1; next} /^## /{flag=0} flag' "$STATE_FILE" | sed '/^$/d' | head -5 | cut -c1-600)

# Lifecycle hints (M019-S03): a closed slice or milestone has a documented next step.
LIFECYCLE_LINES=""
if [ "${CURRENT_MILESTONE:-none}" != none ]; then
  _rm="$YT_DIR/$CURRENT_MILESTONE-ROADMAP.md"
  if [ -f "$_rm" ] && [ "$(sed -n 's/^status: *//p' "$_rm" | head -1)" = done ] && [ ! -f "$YT_DIR/$CURRENT_MILESTONE-RETRO.md" ]; then
    LIFECYCLE_LINES="Milestone $CURRENT_MILESTONE is done and has no retro: ytstack:retro, then ytstack:document-release for the version, then ytstack:plan-milestone."
  elif [ "${ACTIVE_SLICE:-none}" != none ] && [ -f "$YT_DIR/$CURRENT_MILESTONE-$ACTIVE_SLICE-PLAN.md" ] \
       && [ "$(sed -n 's/^status: *//p' "$YT_DIR/$CURRENT_MILESTONE-$ACTIVE_SLICE-PLAN.md" | head -1)" = done ]; then
    LIFECYCLE_LINES="Slice $ACTIVE_SLICE is done: ytstack:reassess-roadmap first; then ytstack:finish-branch (merge / PR / keep) or ytstack:ship (release flow) for the branch."
  fi
fi

# Recent summary file names (last 3 by mtime)
# (M018-S03: flat layout plus milestones/, quick/ etc. via the lib)
RECENT_SUMMARIES=$(yt_find_artifacts "$YT_DIR" '*-SUMMARY.md' | head -3 | while read -r f; do
  basename "$f" .md
done | paste -sd, - | sed 's/,/, /g')

# Milestones in progress (M018 states): more than one is a pointer-drift smell.
IN_PROGRESS=$(grep -l '^status: in-progress' "$YT_DIR"/M[0-9][0-9][0-9]-ROADMAP.md 2>/dev/null | while read -r f; do basename "$f" -ROADMAP.md; done | paste -sd, - | sed 's/,/, /g')
# grep -c prints 0 itself (exit 1); a `|| echo 0` here produced "0\n0" and broke the -gt test.
IN_PROGRESS_N=$(printf '%s' "$IN_PROGRESS" | tr ',' '\n' | grep -c . 2>/dev/null)
IN_PROGRESS_N=${IN_PROGRESS_N:-0}

# STATE pointer lint + ceremony dials (M018): read-only, both from the lib.
yt_state_lint "$YT_DIR" >/dev/null
LINT_LINES=""
if [ "${YT_STATE_WARN_COUNT:-0}" -gt 0 ]; then
  LINT_LINES="STATE lint ($YT_STATE_WARN_COUNT):
$(printf '%s\n' "$YT_STATE_WARNINGS" | head -5 | sed 's/^/- /')
Fix STATE.md (or run ytstack:reconcile) before planning; plan-task and summarize-task refuse a malformed pointer."
fi
yt_prefs "$YT_DIR" >/dev/null
MINIMAL_CODE_LINES=""
if [ "${YT_PREF_MINIMAL_CODE:-on}" = on ]; then
  MINIMAL_CODE_LINES="Minimal-code guard is on (PREFERENCES minimal_code). Before writing code, load ytstack:minimal-code via the Skill tool: climb the ladder (needed at all? exists in the codebase? stdlib? existing dependency? one line? otherwise the minimum that passes the test), never cut validation / auth / boundary error handling / accessibility / the one small test, mark deliberate shortcuts with a \`shortcut:\` comment."
fi

# Handoffs: the user-written one in the tree, the automatic one out of tree.
HANDOFF_LINES=""
if [ -f "$YT_DIR/HANDOFF.md" ]; then
  H_EVENT=$(sed -n 's/^event: *//p' "$YT_DIR/HANDOFF.md" | head -1)
  H_TS=$(sed -n 's/^timestamp: *//p' "$YT_DIR/HANDOFF.md" | head -1)
  HANDOFF_LINES="Manual handoff: $YT_DIR/HANDOFF.md (event: ${H_EVENT:-unknown}${H_TS:+, $H_TS})"
fi
# Path computed without creating anything (read-only hook).
LATEST_LINK="$(yt_state_base)/repos/$YT_REPO_KEY/worktrees/$YT_WT_KEY/latest-handoff"
if [ -L "$LATEST_LINK" ] && [ -f "$LATEST_LINK" ]; then
  A_TARGET=$(readlink "$LATEST_LINK")
  A_TS=$(sed -n 's/^timestamp: *//p' "$A_TARGET" 2>/dev/null | head -1)
  HANDOFF_LINES="${HANDOFF_LINES:+$HANDOFF_LINES
}Latest automatic handoff: $A_TARGET${A_TS:+ ($A_TS)}"
fi

build_state_context() {
  local next="$1"
  local ctx="[ytstack active -- scope: $YT_SCOPE]

Project: ${PROJECT:-unknown}
Current: ${CURRENT_MILESTONE:-none}${ACTIVE_SLICE:+ / $ACTIVE_SLICE}${ACTIVE_TASK:+ / $ACTIVE_TASK}
Last updated: ${LAST_UPDATED:-unknown}
Working tree: $YT_TOPLEVEL${YT_IS_LINKED:+ (linked worktree: $YT_IS_LINKED)}
ytstack dir: $YT_DIR"
  if [ -n "$next" ]; then
    ctx="$ctx

Next action:
$next"
  fi
  if [ -n "$RECENT_SUMMARIES" ]; then
    ctx="$ctx

Recent tasks: $RECENT_SUMMARIES"
  fi
  if [ "${IN_PROGRESS_N:-0}" -gt 1 ]; then
    ctx="$ctx

Milestones in progress: $IN_PROGRESS (more than one -- check the STATE pointer; run ytstack:reassess-roadmap to close or drop the stale one)"
  fi
  if [ -n "$HANDOFF_LINES" ]; then
    ctx="$ctx

$HANDOFF_LINES"
  fi
  if [ -n "$LIFECYCLE_LINES" ]; then
    ctx="$ctx

$LIFECYCLE_LINES"
  fi
  if [ -n "$LINT_LINES" ]; then
    ctx="$ctx

$LINT_LINES"
  fi
  if [ -n "$MINIMAL_CODE_LINES" ]; then
    ctx="$ctx

$MINIMAL_CODE_LINES"
  fi
  ctx="$ctx

The files in $YT_DIR are the source of truth for this project's state. Read STATE.md for the full dashboard, DECISIONS.md for locked architectural choices, KNOWLEDGE.md for patterns and gotchas, ROADMAP.md for the task list. Do not rely on prior-conversation context for these facts."
  printf '%s' "$ctx"
}

STATE_CONTEXT=$(build_state_context "$NEXT_ACTION")
FULL_CONTEXT="$DIRECTIVE

---

$STATE_CONTEXT"

# Claude Code drops SessionStart additionalContext beyond 10,000 chars (the
# overflow is spilled to a file the agent is not told about). Shed the Next
# action excerpt first, then warn. The cap is Claude Code's: host context a
# non-Claude adapter prepends (YTSTACK_HOST_CONTEXT, e.g. codex/adapter.md)
# is not counted; that host's own limit lives in its hooks config.
_HOST="${YTSTACK_HOST_CONTEXT:-}"; _HOST_LEN=${#_HOST}
if [ $(( ${#FULL_CONTEXT} - _HOST_LEN )) -gt 9500 ]; then
  STATE_CONTEXT=$(build_state_context "(omitted: see STATE.md -- injection near the 10,000-char cap)")
  FULL_CONTEXT="$DIRECTIVE

---

$STATE_CONTEXT"
  if [ $(( ${#FULL_CONTEXT} - _HOST_LEN )) -gt 9500 ]; then
    echo "[ytstack session-start] injection is $(( ${#FULL_CONTEXT} - _HOST_LEN )) chars; Claude Code caps additionalContext at 10,000. Shorten skills/using-ytstack/SKILL.md." >&2
  fi
fi

emit_json "$FULL_CONTEXT"
exit 0

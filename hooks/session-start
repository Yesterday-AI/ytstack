#!/usr/bin/env bash
# ytstack SessionStart hook
#
# Injects two things as additionalContext:
#
#   1. The full content of skills/using-ytstack/SKILL.md -- the directive that
#      tells the agent to auto-invoke ytstack skills based on user intent
#      (superpowers-style proactive skill selection).
#
#   2. The current project state from .ytstack/STATE.md -- so the agent knows
#      where we are in the milestone/slice/task hierarchy -- plus pointers to
#      the user-written HANDOFF.md and the latest automatic (out-of-tree)
#      handoff written by the pre-compact hook.
#
# Resolution: payload `cwd` -> hooks/lib/git-ctx.sh (never CLAUDE_PROJECT_DIR,
# which is pinned to the session-start dir and does not follow worktrees;
# DECISIONS 2026-11-07). Read-only: writes nothing anywhere.
#
# Claude Code caps SessionStart additionalContext at 10,000 characters; the
# hook measures its output and shrinks the blocks named above the cap code;
# the Next action excerpt is never cut (issue #82).

set -uo pipefail
trap '' PIPE

. "$(cd "$(dirname "$0")" && pwd)/lib/git-ctx.sh"

yt_read_stdin
yt_git_ctx "${YT_CWD:-$PWD}"
yt_resolve_yt_dir >/dev/null    # sets YT_DIR + YT_SCOPE (project|user|none) in this shell

STATE_FILE="${YT_DIR:+$YT_DIR/STATE.md}"

# Load the using-ytstack directive (source-of-truth lives in the plugin).
# Injected on EVERY session start where the plugin is active -- including
# greenfield sessions with no .ytstack/ yet, because the directive's job is to
# route greenfield build-intent to office-hours BEFORE any infra exists.
PLUGIN_ROOT="${CLAUDE_PLUGIN_ROOT:-$(cd "$(dirname "$0")/.." && pwd)}"
USING_YTSTACK_FILE="$PLUGIN_ROOT/skills/using-ytstack/SKILL.md"
USING_SKILL=""
[ ! -f "$USING_YTSTACK_FILE" ] || USING_SKILL=$(cat "$USING_YTSTACK_FILE")

# The only no-op case: we cannot prime the agent if the directive is missing.
[ -z "$USING_SKILL" ] && exit 0
NL='
'

# Helper: emit additionalContext JSON, or raw context for a plain-stdout host.
emit_json() {
  local content="$1" jq_bin py_bin
  if [ "${YTSTACK_HOOK_FORMAT:-json}" = plain ]; then
    printf '%s\n' "$content"
    return 0
  fi
  jq_bin=$(yt_jq); py_bin=$(yt_python)
  if [ -n "$jq_bin" ]; then
    printf '%s' "$content" | "$jq_bin" -Rs '{hookSpecificOutput: {hookEventName: "SessionStart", additionalContext: .}}'
  elif [ -n "$py_bin" ]; then
    printf '%s' "$content" | "$py_bin" -I -c 'import sys, json; print(json.dumps({"hookSpecificOutput": {"hookEventName": "SessionStart", "additionalContext": sys.stdin.read()}}))'
  else
    # Last-resort raw -- won't safely handle embedded quotes/newlines
    printf '{"hookSpecificOutput":{"hookEventName":"SessionStart","additionalContext":"%s"}}\n' "$content"
  fi
}

# directive <skill text>: DIRECTIVE, with the host context in front when set.
directive() {
  DIRECTIVE="<EXTREMELY_IMPORTANT>
You have ytstack. Below is the full content of your 'ytstack:using-ytstack' skill, which tells you how to find and invoke ytstack skills based on user intent. Follow it. For all other skills, use the 'Skill' tool:

${YTSTACK_HOST_CONTEXT:+$YTSTACK_HOST_CONTEXT

}$1
</EXTREMELY_IMPORTANT>"
}
directive "$USING_SKILL"

# Greenfield: no .ytstack/ exists for this checkout. An existing, documented
# codebase (README, docs/, CHANGELOG, ADRs, commit history; M010 / issue #18)
# is told apart by the shared detector so build-intent routes to
# adopt-brownfield instead of the office-hours pitch.
if [ -z "$YT_DIR" ]; then
  yt_brownfield_signals "$YT_TOPLEVEL"
  if [ "${YT_BROWNFIELD_SIGNALS:-0}" -ge 2 ]; then
    BF_SOURCES=$(printf '%s\n' "$YT_BROWNFIELD_HINTS" | sed 's/ ->.*//' | paste -sd, - | sed 's/,/, /g')
    GREENFIELD_STATE="[ytstack active -- scope: greenfield (existing codebase, no .ytstack/)]

No \`.ytstack/\` directory in $YT_TOPLEVEL, but this looks like an existing codebase ($YT_BROWNFIELD_SIGNALS brownfield signals: $BF_SOURCES).

For build-intent, work requests or \"set up ytstack here\": invoke \`ytstack:adopt-brownfield\` FIRST, not office-hours. It links the existing docs into \`.ytstack/\`, maps the codebase, and scaffolds only the gaps; the shipped track record is the validation. Do NOT invoke init-project (it would route here anyway) and do NOT run the office-hours pitch on an existing product. Reserve \`ytstack:office-hours\` for genuinely new scope the user describes as a new idea."
  else
    GREENFIELD_STATE="[ytstack active -- scope: greenfield]

No \`.ytstack/\` directory in $YT_TOPLEVEL (or any parent). This is greenfield.

Greenfield flow per the using-ytstack directive above:
1. If the user expresses build-intent (\"baue mir X\", \"build me X\", \"new project\", \"I have an idea\"), invoke \`ytstack:office-hours\` FIRST to validate the pitch. Do NOT invoke plan-milestone or init-project directly.
2. After office-hours produces OFFICE-HOURS.md, invoke \`ytstack:plan-ceo-review\` (concept mode) to stress-test premise + scope.
3. Optionally \`ytstack:plan-eng-review\` (concept mode) for feasibility.
4. Then \`ytstack:init-project\` to scaffold \`.ytstack/\` (populates PROJECT.md from the pitch, no cold PM questions).
Existing codebase with its own README/docs but no \`.ytstack/\`? Use \`ytstack:adopt-brownfield\` instead of the pitch."
  fi

  emit_json "$DIRECTIVE

---

$GREENFIELD_STATE"
  exit 0
fi

# Brownfield: .ytstack/ exists. Handle missing STATE.md as anomaly.
if [ ! -f "$STATE_FILE" ]; then
  emit_json "$DIRECTIVE

---

[ytstack] $YT_DIR exists but STATE.md is missing. Run /ytstack:init-project to repair, or remove the directory."
  exit 0
fi

# A checkout on the default branch behind origin/<default> (local refs, no
# fetch; issue #82): its STATE.md is stale, so pointer and Next action come
# from origin's copy, and the line says how far behind it is.
STATE_TEXT=$(cat "$STATE_FILE" 2>/dev/null)
BEHIND_LINE=""
YT_BEHIND_N=0
[ "$YT_IS_GIT" != yes ] || yt_behind_origin "$YT_TOPLEVEL" "$YT_DIR"
if [ "${YT_BEHIND_N:-0}" -gt 0 ]; then
  if [ -n "$YT_BEHIND_STATE" ]; then
    STATE_TEXT="$YT_BEHIND_STATE"
    BEHIND_LINE="Checkout: $YT_BEHIND_N commit(s) behind $YT_BEHIND_REF (local refs, not fetched). Pointer and Next action are read from $YT_BEHIND_REF; the other files here are older, so the STATE lint waits. Bring the checkout up to date first: git merge --ff-only $YT_BEHIND_REF."
  else
    BEHIND_LINE="Checkout: $YT_BEHIND_N commit(s) behind $YT_BEHIND_REF (local refs, not fetched); the files here are older. Bring the checkout up to date first: git merge --ff-only $YT_BEHIND_REF."
  fi
fi

# Extract frontmatter fields from STATE.md
get_field() { printf '%s\n' "$STATE_TEXT" | sed -n "s/^$1: *//p" | head -1; }
PROJECT=$(get_field project)
CURRENT_MILESTONE=$(get_field current_milestone)
ACTIVE_SLICE=$(get_field active_slice)
ACTIVE_TASK=$(get_field active_task)
LAST_UPDATED=$(get_field last_updated)

# "Next action" body (up to the next ## header), trimmed
NEXT_ACTION=$(printf '%s\n' "$STATE_TEXT" | awk '/^## Next action/{flag=1; next} /^## /{flag=0} flag' | sed '/^$/d' | head -5 | cut -c1-600)

# Lifecycle hints (M019-S03): a closed slice or milestone has a documented next step.
LIFECYCLE_LINES=""
if [ "${CURRENT_MILESTONE:-none}" != none ]; then
  _rm=$(yt_artifact_path "$YT_DIR" "$CURRENT_MILESTONE-ROADMAP.md")
  _sp=$(yt_artifact_path "$YT_DIR" "$CURRENT_MILESTONE-${ACTIVE_SLICE:-none}-PLAN.md")
  if [ -f "$_rm" ] && [ "$(sed -n 's/^status: *//p' "$_rm" | head -1)" = done ] && [ ! -f "$(yt_artifact_path "$YT_DIR" "$CURRENT_MILESTONE-RETRO.md")" ]; then
    LIFECYCLE_LINES="Milestone $CURRENT_MILESTONE is done and has no retro: ytstack:retro, then ytstack:document-release for the version, then ytstack:plan-milestone."
  elif [ "${ACTIVE_SLICE:-none}" != none ] && [ -f "$_sp" ] \
       && [ "$(sed -n 's/^status: *//p' "$_sp" | head -1)" = done ]; then
    LIFECYCLE_LINES="Slice $ACTIVE_SLICE is done: ytstack:reassess-roadmap first; then ytstack:finish-branch (merge / PR / keep) or ytstack:ship (release flow) for the branch."
  fi
fi

# Recent summary file names (last 3 by mtime)
# (M018-S03: flat layout plus milestones/, quick/ etc. via the lib)
RECENT_SUMMARIES=$(yt_find_artifacts "$YT_DIR" '*-SUMMARY.md' | head -3 | while read -r f; do
  basename "$f" .md
done | paste -sd, - | sed 's/,/, /g')

# Milestones in progress (M018 states): more than one is a pointer-drift smell.
IN_PROGRESS=$(grep -l '^status: in-progress' "$YT_DIR"/M[0-9][0-9][0-9]-ROADMAP.md 2>/dev/null | while read -r f; do basename "$f" -ROADMAP.md; done | paste -sd, - | sed 's/,/, /g')
# grep -c prints 0 itself (exit 1); a `|| echo 0` here produced "0\n0" and broke the -gt test.
IN_PROGRESS_N=$(printf '%s' "$IN_PROGRESS" | tr ',' '\n' | grep -c . 2>/dev/null)
IN_PROGRESS_N=${IN_PROGRESS_N:-0}

# STATE pointer lint + ceremony dials (M018): read-only, both from the lib.
yt_state_lint "$YT_DIR" >/dev/null
LINT_LINES=""
if [ "${YT_STATE_WARN_COUNT:-0}" -gt 0 ] && [ "${YT_BEHIND_N:-0}" -eq 0 ]; then
  LINT_LINES="STATE lint ($YT_STATE_WARN_COUNT):
$(printf '%s\n' "$YT_STATE_WARNINGS" | head -5 | sed 's/^/- /')
A malformed pointer stops plan-task and summarize-task: fix STATE.md first. Size and history findings do not block; ytstack:reconcile moves history out with your consent."
fi
yt_prefs "$YT_DIR" >/dev/null
MINIMAL_CODE_LINES=""
if [ "${YT_PREF_MINIMAL_CODE:-on}" = on ]; then
  MINIMAL_CODE_LINES="Minimal-code guard is on (PREFERENCES minimal_code): smallest complete change, smallest sufficient evidence. Before writing code or adding a check, load ytstack:minimal-code via the Skill tool: climb the ladder (needed at all? in the codebase? stdlib? existing dependency? one line?), never cut validation / auth / boundary error handling / accessibility / the one small test, run what the plan's Verification names and no more, end reports with 'Not checked:'."
fi

# Factory tools that are off although the project would use them (M031-S03).
# Said once per session without a marker file: only when the session starts or
# is cleared, never on resume or compaction (Kimi's PostCompact neither).
FACTORY_LINES=""
case "${YT_SOURCE:-}:${YT_HOOK_EVENT:-}" in
  startup:*|clear:*|:|:SessionStart)
    yt_factory_notices "$YT_DIR" "$YT_TOPLEVEL"
    if [ -n "$YT_FACTORY_NOTICES" ]; then
      FACTORY_LINES="Factory tools (said once per session):
$(printf '%s\n' "$YT_FACTORY_NOTICES" | sed 's/^/- /')"
    fi ;;
esac

# Handoffs: the user-written one in the tree, the automatic one out of tree.
# A manual handoff older than the automatic one is listed as older (#82).
HANDOFF_LINES=""
A_TS=""
# Path computed without creating anything (read-only hook).
LATEST_LINK="$(yt_state_base)/repos/$YT_REPO_KEY/worktrees/$YT_WT_KEY/latest-handoff"
if [ -L "$LATEST_LINK" ] && [ -f "$LATEST_LINK" ]; then
  A_TARGET=$(readlink "$LATEST_LINK")
  A_TS=$(sed -n 's/^timestamp: *//p' "$A_TARGET" 2>/dev/null | head -1)
  HANDOFF_LINES="Latest automatic handoff: $A_TARGET${A_TS:+ ($A_TS)}"
fi
if [ -f "$YT_DIR/HANDOFF.md" ]; then
  H_EVENT=$(sed -n 's/^event: *//p' "$YT_DIR/HANDOFF.md" | head -1)
  H_TS=$(sed -n 's/^timestamp: *//p' "$YT_DIR/HANDOFF.md" | head -1)
  _HE=$(yt_epoch "$H_TS"); _AE=$(yt_epoch "$A_TS")
  if [ -n "$_HE" ] && [ -n "$_AE" ] && [ "$_HE" -lt "$_AE" ]; then
    HANDOFF_LINES="$HANDOFF_LINES
Older manual handoff: $YT_DIR/HANDOFF.md (event: ${H_EVENT:-unknown}, $H_TS; older than the automatic one)"
  else
    HANDOFF_LINES="Manual handoff: $YT_DIR/HANDOFF.md (event: ${H_EVENT:-unknown}${H_TS:+, $H_TS})${HANDOFF_LINES:+
$HANDOFF_LINES}"
  fi
fi

# Standing instructions (issue #74): the active entries of standing/, files
# only (no until-check or check runs here; a passed `until` is applied), for
# the session's role: coordinator when the coordinate preamble left its
# session marker, else lane. At most 6 lines; the rest is a pointer. Pending
# entries count too, also before the checkout has a standing/ directory.
STANDING_LINES=""; STANDING_N=0
_ROLE=lane
case "${YT_SESSION_ID:-}" in ''|.|..|*[!A-Za-z0-9._-]*) ;; *) [ ! -f "$(yt_session_home)/$YT_SESSION_ID/coordinate" ] || _ROLE=coordinator ;; esac
_ALL=$(yt_standing_lines "$YT_DIR" "$_ROLE")
_SL=""
if [ -n "$_ALL" ]; then
  _SL=$(yt_standing_lines "$YT_DIR" "$_ROLE" 6 | cut -c1-150)
  STANDING_N=$(printf '%s\n' "$_ALL" | grep -c .)
  _SH="Standing instructions in force (role: $_ROLE; they override defaults; full text in standing/, of a pending one in bin/ytstack-standing list):"
  STANDING_LINES="$_SH
$_SL"
fi
[ ! -f "$YT_DIR/STANDING.md" ] || STANDING_LINES="${STANDING_LINES:+$STANDING_LINES
}Also read $YT_DIR/STANDING.md."

# Coordinate mode (issue #76): the operating checklist, read from its one
# place (docs/ux/coordinator-format.md, between the operating-checklist
# markers). A coordinator writes no product code, so the minimal-code line
# gives way to it.
CHECKLIST_LINES=""
if [ "$_ROLE" = coordinator ]; then
  CHECKLIST_LINES=$(awk '/<!-- operating-checklist:end -->/ { f = 0 } f { print } /<!-- operating-checklist:begin -->/ { f = 1 }' "$PLUGIN_ROOT/docs/ux/coordinator-format.md" 2>/dev/null)
  [ -z "$CHECKLIST_LINES" ] || MINIMAL_CODE_LINES=""
fi
# After a compaction of a coordinator (counted by hooks/pre-compact beside the
# marker; issue #83): rotate now, coordinate Step 12.
COMPACT_LINE=""
if [ "$_ROLE" = coordinator ] && [ "${YT_SOURCE:-}" = compact ]; then
  _CN=$(grep -c . "$(yt_session_home)/$YT_SESSION_ID/compactions" 2>/dev/null); case "$_CN" in ''|*[!0-9]*|0) _CN=1 ;; esac
  COMPACT_LINE="Compaction $_CN of this coordinator: ytstack:coordinate Step 12, rotate now."
fi

# Technical spec (M022): name the entry point when the project has one.
SPEC_HINT=""
[ ! -f "$YT_DIR/spec/SPEC.md" ] || SPEC_HINT=" spec/SPEC.md for what applies now,"

build_state_context() {
  local next="$1"
  local ctx="[ytstack active -- scope: $YT_SCOPE]

Project: ${PROJECT:-unknown}
Current: ${CURRENT_MILESTONE:-none}${ACTIVE_SLICE:+ / $ACTIVE_SLICE}${ACTIVE_TASK:+ / $ACTIVE_TASK}
Last updated: ${LAST_UPDATED:-unknown}
Working tree: $YT_TOPLEVEL${YT_IS_LINKED:+ (linked worktree: $YT_IS_LINKED)}
ytstack dir: $YT_DIR"
  if [ -n "$BEHIND_LINE" ]; then
    ctx="$ctx
$BEHIND_LINE"
  fi
  if [ -n "$COMPACT_LINE" ]; then
    ctx="$ctx

$COMPACT_LINE"
  fi
  if [ -n "$next" ]; then
    ctx="$ctx

Next action:
$next"
  fi
  if [ -n "$RECENT_SUMMARIES" ]; then
    ctx="$ctx

Recent tasks: $RECENT_SUMMARIES"
  fi
  if [ "${IN_PROGRESS_N:-0}" -gt 1 ]; then
    ctx="$ctx

Milestones in progress: $IN_PROGRESS (more than one -- check the STATE pointer; run ytstack:reassess-roadmap to close or drop the stale one)"
  fi
  if [ -n "$CHECKLIST_LINES" ]; then
    ctx="$ctx

$CHECKLIST_LINES"
  fi
  if [ -n "$STANDING_LINES" ]; then
    ctx="$ctx

$STANDING_LINES"
  fi
  if [ -n "$HANDOFF_LINES" ]; then
    ctx="$ctx

$HANDOFF_LINES"
  fi
  if [ -n "$LIFECYCLE_LINES" ]; then
    ctx="$ctx

$LIFECYCLE_LINES"
  fi
  if [ -n "$LINT_LINES" ]; then
    ctx="$ctx

$LINT_LINES"
  fi
  if [ -n "$MINIMAL_CODE_LINES" ]; then
    ctx="$ctx

$MINIMAL_CODE_LINES"
  fi
  if [ -n "$FACTORY_LINES" ]; then
    ctx="$ctx

$FACTORY_LINES"
  fi
  ctx="$ctx

$CLOSING_LINE"
  printf '%s' "$ctx"
}
CLOSING_LINE="The files in $YT_DIR are the source of truth for this project's state. Read STATE.md for the full dashboard,${SPEC_HINT} DECISIONS.md for locked architectural choices, KNOWLEDGE.md for patterns and gotchas, ROADMAP.md for the task list. Do not rely on prior-conversation context for these facts."

STATE_CONTEXT=$(build_state_context "$NEXT_ACTION")
FULL_CONTEXT="$DIRECTIVE

---

$STATE_CONTEXT"

# Claude Code drops SessionStart additionalContext beyond 10,000 chars (the
# overflow is spilled to a file the agent is not told about). The cap is
# Claude Code's: host context a non-Claude adapter prepends
# (YTSTACK_HOST_CONTEXT, e.g. codex/adapter.md) is not counted; that host's
# own limit lives in its hooks config. Above the guard the blocks shrink in
# this order: the standing lines to the three newest, the factory lines to a
# pointer, the minimal-code line to its pointer, the closing line to its
# short form, the standing lines to a pointer, last the using-ytstack body to
# what fits, cut at a line end, with a pointer to the file (issue #82: the
# Next action comes before that body). The Next action excerpt (at most five
# lines of 600 characters), the operating checklist and the lines about the
# checkout and a compaction are never cut. Still above the guard: a warning.
_HOST="${YTSTACK_HOST_CONTEXT:-}"; _HOST_LEN=${#_HOST}
over() { [ $(( ${#FULL_CONTEXT} - _HOST_LEN )) -gt 9500 ]; }
rebuild() {
  STATE_CONTEXT=$(build_state_context "$NEXT_ACTION")
  FULL_CONTEXT="$DIRECTIVE

---

$STATE_CONTEXT"
}
if over && [ -n "${_SL:-}" ]; then
  STANDING_LINES="$_SH
$(yt_standing_lines "$YT_DIR" "$_ROLE" 3 | cut -c1-100)"
  rebuild
fi
if over && [ -n "$FACTORY_LINES" ]; then
  _FN=$(printf '%s\n' "$YT_FACTORY_NOTICES" | grep -c .)
  FACTORY_LINES="Factory tools: $_FN off (list cut for the 10,000-char cap): bin/ytstack-upkeep names them."
  rebuild
fi
if over && [ -n "$MINIMAL_CODE_LINES" ]; then
  MINIMAL_CODE_LINES="Minimal-code guard is on: load ytstack:minimal-code before writing code."
  rebuild
fi
if over; then
  CLOSING_LINE="The files in $YT_DIR are the source of truth (STATE.md,${SPEC_HINT} DECISIONS.md, KNOWLEDGE.md), not the conversation."
  rebuild
fi
if over && [ -n "$STANDING_LINES" ]; then
  STANDING_LINES="Standing instructions: $STANDING_N in force for role $_ROLE (cut for the cap): bin/ytstack-standing list, before you act."
  rebuild
fi
if over; then
  _NOTE="(cut for the 10,000-char cap: read the rest in $USING_YTSTACK_FILE)"
  _KEEP=$(( ${#USING_SKILL} - (${#FULL_CONTEXT} - _HOST_LEN - 9500) - ${#_NOTE} - 2 ))
  [ "$_KEEP" -gt 0 ] || _KEEP=0
  _CUT="${USING_SKILL:0:$_KEEP}"
  _CUT="${_CUT%"$NL"*}"
  directive "$_CUT

$_NOTE"
  rebuild
  _BODY_CUT=yes
fi
if over; then
  echo "[ytstack session-start] injection is $(( ${#FULL_CONTEXT} - _HOST_LEN )) chars; Claude Code caps additionalContext at 10,000. Shorten skills/using-ytstack/SKILL.md." >&2
fi

# The running version's bin/ (issue #85), on every source: skills run bins as
# "$YT_BIN/ytstack-<name>", not by a path from an earlier context. Only where it
# still fits under the guard and the using-ytstack body was not cut; it never
# costs the Next action or the directive (coordinate's
# preamble prints it too).
_YT_BIN_LINE="YT_BIN=$(cd "$PLUGIN_ROOT/bin" 2>/dev/null && pwd -P || printf '%s' "$PLUGIN_ROOT/bin")"
if [ "${_BODY_CUT:-no}" = no ] && [ $(( ${#FULL_CONTEXT} - _HOST_LEN + ${#_YT_BIN_LINE} + 2 )) -le 9500 ]; then
  FULL_CONTEXT="$FULL_CONTEXT

$_YT_BIN_LINE"
fi

emit_json "$FULL_CONTEXT"
exit 0

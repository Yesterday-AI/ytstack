#!/usr/bin/env bash
# ytstack UserPromptSubmit hook: standing instructions in a coordinator session
# (issue #72). Active only in coordinate mode: the coordinate preamble writes
# the marker <session home>/<session id>/coordinate (yt_session_home in
# hooks/lib/git-ctx.sh; DECISIONS 2026-11-15 "coordinate mode is a session
# marker"). Without it the hook ends at once, without reading git.
#
# In coordinate mode, per human prompt:
#   1. appends the epoch to <session dir>/prompts (the coordinate preamble
#      counts the prompts since the newest standing entry);
#   2. when the prompt reads like a standing instruction (instruction phrases:
#      from now on, going forward, until further notice, don't touch,
#      prioritise, an imperative "always/never <verb>" at a clause start;
#      German: ab jetzt, ab sofort, von nun an, bis auf weiteres, solange ...
#      nicht, grundsaetzlich, immer wenn, nie wieder, denk dran, merk dir,
#      priorisiere, fass ... nicht an; a prompt that is only a question is not),
#      appends it to <session dir>/standing-flags for hooks/stop and injects
#      one line: record it under .ytstack/standing/ before the next dispatch.
# A prompt that starts with "<" (a task notification, a system message) is no
# human prompt and is skipped; a task notification (a worker's report) is
# appended to <session dir>/reports for hooks/stop.
#
# Files and grep only; no command of a standing entry runs here. Fail open:
# any problem ends silent with exit 0. Output: the UserPromptSubmit
# additionalContext JSON; YTSTACK_HOOK_FORMAT=plain prints the text.

set -uo pipefail
trap '' PIPE

. "$(cd "$(dirname "$0")" && pwd)/lib/git-ctx.sh"

yt_read_stdin
SID="${YT_SESSION_ID:-}"
case "$SID" in ''|.|..|*[!A-Za-z0-9._-]*) exit 0 ;; esac
SD="$(yt_session_home)/$SID"
[ -f "$SD/coordinate" ] || exit 0

JQ=$(yt_jq)
if [ -n "$JQ" ]; then
  PROMPT=$(printf '%s' "$YT_STDIN" | "$JQ" -r '.prompt | if type == "string" then . elif type == "array" then map(.text? // "") | join(" ") else "" end' 2>/dev/null) || exit 0
elif [ -n "$(yt_python)" ]; then
  PROMPT=$(printf '%s' "$YT_STDIN" | "$(yt_python)" -I -c '
import json, sys
try:
    p = json.load(sys.stdin).get("prompt", "")
except Exception:
    p = ""
if isinstance(p, list):
    p = " ".join(str(i.get("text", "")) for i in p if isinstance(i, dict))
print(p if isinstance(p, str) else "")
' 2>/dev/null) || exit 0
else
  exit 0
fi
PROMPT="${PROMPT:0:4000}"
# A worker's report arrives as a task notification: a lane event for the
# LANES.md check of hooks/stop (issue #76), not a human prompt.
case "${PROMPT#"${PROMPT%%[![:space:]]*}"}" in
  '<task-notification'*) printf '%s\n' "$(date +%s)" >> "$SD/reports" 2>/dev/null; exit 0 ;;
  ''|'<'*) exit 0 ;;
esac

NOW=$(date +%s)
printf '%s\n' "$NOW" >> "$SD/prompts" 2>/dev/null || exit 0

# Instruction phrases, not single words: "bis", "nie", "immer", "while",
# "until" and "never" alone occur in ordinary questions ("bis wann?", "never
# mind", "ist das immer noch rot?"). "always"/"never" count only as an
# imperative at the start of a clause ("Never merge on Fridays."). A prompt
# that is one question and nothing else is never flagged.
# Word boundaries without \b (BSD and BusyBox grep differ): a non-letter or the
# line edge on both sides. LC_ALL=C keeps the umlaut bytes out of [:alnum:].
B='(^|[^[:alnum:]])'
E='([^[:alnum:]]|$)'
# Temporary instructions (#73): a hold or prohibition with until/bis and a time
# or a condition ("hold merges until 12:37", "bis 12:37 keine Merges", "no
# deploys while the load test runs"), and until/solange opening a clause.
EN="from now on|going forward|from here on|until further notice|don'?t touch|do not touch|hands off|prioriti[sz]e|leave [^.!?]{1,60} alone|remember to|keep in mind|no more [a-z]+ until|(hold|pause|freeze|block|stop|no|don'?t|do not|never)[^.!?]{0,40} (until|till|while) [a-z0-9]+"
DE="ab jetzt|ab sofort|von nun an|von jetzt an|ab heute|bis auf weiteres|solange [^.!?]{1,60} (nicht|keine?)|grunds(ae|ä)tzlich|immer wenn|nie wieder|nie mehr|niemals|denk dran|denk daran|merk dir|priorisier[a-z]*|fass [^.!?]{1,60} nicht an|nicht anfassen|k(ue|ü)nftig|in zukunft|bis [0-9][0-9:.]*( uhr)?[^.!?]{0,30} (keine?|nicht|nichts)|(keine?|nicht|nichts)[^.!?]{0,40} (bis|solange|w(ae|ä)hrend) [a-z0-9]+"
# At the start of the prompt or of a clause (after . ! ? ; : or a dash):
# always/never + a verb (not "never mind"), until + a condition, solange + a clause.
IMP='(^|[.!?;:]|--| - )[[:space:]]*(please[[:space:]]+)?((always|never)[[:space:]]+[a-z]+|until[[:space:]]+[a-z0-9]+|solange[[:space:]]+[a-z]+)'
LOW=$(printf '%s' "$PROMPT" | tr '\n\r' '  ' | LC_ALL=C tr '[:upper:]' '[:lower:]')
TRIM=$(printf '%s' "$LOW" | sed 's/[[:space:]]*$//')
case "$TRIM" in
  *'?') case "${TRIM%?}" in *[.!?]*) ;; *) exit 0 ;; esac ;;
esac
HIT=$(printf '%s' "$LOW" | LC_ALL=C grep -Eo "$B($EN|$DE)$E" 2>/dev/null | head -1 | LC_ALL=C sed 's/^[^[:alnum:]]*//; s/[^[:alnum:]]*$//')
if [ -z "$HIT" ]; then
  HIT=$(printf '%s' "$LOW" | LC_ALL=C grep -Eo "$IMP" 2>/dev/null | grep -v 'never mind' | head -1 | LC_ALL=C sed 's/^[^[:alnum:]]*//')
fi
[ -n "$HIT" ] || exit 0

EXCERPT=$(printf '%s' "$PROMPT" | tr '\n\r\t' '   ' | cut -c1-100)
printf '%s\t%s\t%s\t%s\n' "$NOW" "$(date -u +%Y%m%d%H%M)" "$(date -u +%Y-%m-%dT%H:%M:%SZ)" "$EXCERPT" >> "$SD/standing-flags" 2>/dev/null || exit 0

ROOT="${CLAUDE_PLUGIN_ROOT:-$(cd "$(dirname "$0")/.." && pwd)}"
TEXT="ytstack: this prompt reads like a standing instruction (\"$HIT\"). If it holds beyond the task at hand, record it before the next dispatch, in your own words: bash \"$ROOT/bin/ytstack-standing\" add \"<the instruction>\" --scope \"<where it applies>\" (add --until <UTC> or --until-condition \"<sentence>\" when it ends). Agent memory is no substitute: a successor and other hosts read only .ytstack/standing/. If it is not one, go on."

if [ "${YTSTACK_HOOK_FORMAT:-json}" = plain ]; then
  printf '%s\n' "$TEXT"
elif [ -n "$JQ" ]; then
  printf '%s' "$TEXT" | "$JQ" -Rs '{hookSpecificOutput: {hookEventName: "UserPromptSubmit", additionalContext: .}}' 2>/dev/null
elif [ -n "$(yt_python)" ]; then
  printf '%s' "$TEXT" | "$(yt_python)" -I -c 'import sys, json; print(json.dumps({"hookSpecificOutput": {"hookEventName": "UserPromptSubmit", "additionalContext": sys.stdin.read()}}))' 2>/dev/null
fi
exit 0

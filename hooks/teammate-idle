#!/usr/bin/env bash
# ytstack TeammateIdle hook (issues #97, #98)
#
# Fires when a Claude Code Agent Teams teammate (also a named subagent while
# Agent Teams are on) is about to go idle. When the teammate's own lane still
# has open tasks, it says so once (exit 2 + stderr keeps the teammate working).
#
# The lane's scope, M###-S## (a slice) or M###-S##-T## (a task):
#   1. the LANES.md row whose "Claimed by" names the teammate. Only a claimed
#      or running row counts; a row in any other status (reported, merged,
#      ...) means the lane's work is in, and the hook stays silent.
#   2. no row: the M###-S##[-T##] ref in the teammate's name (team mode names
#      a teammate after its slice, impl-M004-S02). With held lanes in LANES.md
#      only a milestone among theirs counts.
#   Nothing else: never the STATE pointer, no scope known means silence.
# A milestone whose roadmap says done, dropped, shipped-informally or backlog
# is never counted. Said once per teammate, scope and open count in
# <session home>/<session id>/idle-said: the payload has no loop guard, so a
# repeat idle with no progress stays quiet; progress gives one new message.
# No session id, no teammate name, no jq or python: silent. Fails open.

set -uo pipefail
trap '' PIPE

# Checkout = payload `cwd` via the shared lib (never CLAUDE_PROJECT_DIR;
# DECISIONS 2026-11-07).
. "$(cd "$(dirname "$0")" && pwd)/lib/git-ctx.sh"
yt_read_stdin
case "${YT_SESSION_ID:-}" in ''|.|..|*[!A-Za-z0-9._-]*) exit 0 ;; esac
TM=""
if [ -n "$(yt_jq)" ]; then
  TM=$(printf '%s' "$YT_STDIN" | "$(yt_jq)" -r '.teammate_name // "" | tostring' 2>/dev/null)
elif [ -n "$(yt_python)" ]; then
  TM=$(printf '%s' "$YT_STDIN" | "$(yt_python)" -I -c '
import json, sys
try:
    d = json.load(sys.stdin)
except Exception:
    d = {}
print(d.get("teammate_name") or "" if isinstance(d, dict) else "")' 2>/dev/null)
fi
case "$TM" in ''|*[!A-Za-z0-9._-]*) exit 0 ;; esac

yt_git_ctx "${YT_CWD:-$PWD}"
YT_DIR=$(yt_resolve_yt_dir)
[ -n "$YT_DIR" ] || exit 0

# LANES.md rows: lane TAB status TAB holder (first word of "Claimed by").
ROWS=""
[ -f "$YT_DIR/LANES.md" ] && ROWS=$(awk -F '|' '
  function t(s) { gsub(/^[ \t]+|[ \t]+$/, "", s); return s }
  /^\|/ && NF >= 11 { l = t($2); s = t($4); c = t($5); split(c, w, " ")
    if (l != "" && l != "Lane" && l !~ /^-+$/) print l "\t" s "\t" w[1] }' "$YT_DIR/LANES.md" 2>/dev/null)
MINE=$(printf '%s\n' "$ROWS" | awk -F '\t' -v n="$TM" '$3 == n')
if [ -n "$MINE" ]; then
  SCOPE=$(printf '%s\n' "$MINE" | awk -F '\t' '$2 == "claimed" || $2 == "running" { print $1; exit }')
else
  SCOPE=$(printf '%s\n' "$TM" | grep -oE 'M[0-9]{3}-S[0-9]{2}(-T[0-9]{2})?' | head -1)
  ACTIVE=$(printf '%s\n' "$ROWS" | awk -F '\t' '$3 != "" && $3 != "-" && $2 != "merged" && $2 != "dropped" { print substr($1, 1, 4) }')
  if [ -n "$SCOPE" ] && [ -n "$ACTIVE" ]; then
    printf '%s\n' "$ACTIVE" | grep -qxF "${SCOPE%%-*}" || exit 0
  fi
fi
case "$SCOPE" in M[0-9][0-9][0-9]-S[0-9][0-9]|M[0-9][0-9][0-9]-S[0-9][0-9]-T[0-9][0-9]) ;; *) exit 0 ;; esac
M=${SCOPE%%-*}; REST=${SCOPE#*-}; S=${REST%%-*}; T=""
[ "$REST" = "$S" ] || T=${REST#*-}

ROAD=$(yt_artifact_path "$YT_DIR" "$M-ROADMAP.md")
case "$(sed -n 's/^status:[ ]*\([^ ]*\).*/\1/p' "$ROAD" 2>/dev/null | head -1)" in
  done|dropped|shipped-informally|backlog) exit 0 ;;
esac
PLAN=$(yt_artifact_path "$YT_DIR" "$M-$S-PLAN.md")
[ -f "$PLAN" ] || exit 0
# grep -c prints 0 itself and exits 1; `|| echo 0` would yield "0\n0".
if [ -n "$T" ]; then
  N=$(grep -cE "^- \[ \] $T([^0-9]|\$)" "$PLAN" 2>/dev/null)
else
  N=$(grep -c '^- \[ \] T[0-9][0-9]' "$PLAN" 2>/dev/null)
fi
case "$N" in ''|*[!0-9]*) N=0 ;; esac
[ "$N" -gt 0 ] || exit 0

# Once per teammate, scope and count; silent when it cannot be recorded.
SAID="$(yt_session_home)/$YT_SESSION_ID/idle-said"
KEY="$TM $SCOPE $N"
grep -qxF -- "$KEY" "$SAID" 2>/dev/null && exit 0
mkdir -p "${SAID%/*}" 2>/dev/null && printf '%s\n' "$KEY" >> "$SAID" 2>/dev/null || exit 0

cat >&2 <<EOF
[ytstack] $N task(s) still open in $SCOPE, the lane you hold.
Take the next open one. If none of them is yours to take, tell the lead in one
line and go idle; this is said once per lane and open count.
EOF
exit 2

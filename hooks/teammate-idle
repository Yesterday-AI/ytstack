#!/usr/bin/env bash
# ytstack TeammateIdle hook
#
# Fires when a Claude Code Agent Teams teammate is about to go idle.
# Checks whether the teammate has unfinished work in the shared task list
# and, if so, emits feedback (exit 2) to keep them working.
#
# Idempotent: safe to re-fire; doesn't double-count.

set -uo pipefail
trap '' PIPE

# Checkout = payload `cwd` via the shared lib (never CLAUDE_PROJECT_DIR;
# DECISIONS 2026-11-07).
. "$(cd "$(dirname "$0")" && pwd)/lib/git-ctx.sh"
yt_read_stdin
yt_git_ctx "${YT_CWD:-$PWD}"
YT_DIR=$(yt_resolve_yt_dir)

# Silent exit if not a ytstack project
[ -z "$YT_DIR" ] && exit 0

STATE_FILE="$YT_DIR/STATE.md"
[ ! -f "$STATE_FILE" ] && exit 0

# Determine current milestone + its slice-plans
CURRENT_MILESTONE=$(sed -n 's/^current_milestone: *//p' "$STATE_FILE" | head -1)
[ -z "$CURRENT_MILESTONE" ] || [ "$CURRENT_MILESTONE" = "none" ] && exit 0

# Count unfinished tasks across all slice-plans for this milestone
OPEN_TASK_COUNT=0
for plan in "$YT_DIR"/$CURRENT_MILESTONE-S[0-9][0-9]-PLAN.md; do
  [ -f "$plan" ] || continue
  count=$(grep -c '^- \[ \] T[0-9][0-9]' "$plan" 2>/dev/null || echo 0)
  OPEN_TASK_COUNT=$((OPEN_TASK_COUNT + count))
done

# If everything done, let teammate idle (exit 0, no feedback)
if [ "$OPEN_TASK_COUNT" -eq 0 ]; then
  exit 0
fi

# Otherwise emit feedback via exit 2 + stderr (lead gets the message)
cat >&2 <<EOF
[ytstack] $OPEN_TASK_COUNT task(s) still open in milestone $CURRENT_MILESTONE.
Check the shared task list and claim the next unblocked task. If you believe
you have no claimable work, confirm with the lead before going idle.
EOF
exit 2

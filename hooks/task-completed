#!/usr/bin/env bash
# ytstack TaskCompleted hook
#
# Fires when a task is marked complete via TaskUpdate/TaskCompleted in Agent
# Teams. Creates a minimal auto-SUMMARY skeleton at the corresponding
# M###-S##-T##-SUMMARY.md path so the artifact exists; human or agent can
# elaborate later via ytstack:summarize-task.

set -uo pipefail

PROJECT_DIR="${CLAUDE_PROJECT_DIR:-$PWD}"
cd "$PROJECT_DIR" 2>/dev/null || exit 0

YT_DIR=""
if [ -d "$PROJECT_DIR/.ytstack" ]; then
  YT_DIR="$PROJECT_DIR/.ytstack"
else
  SLUG=$(basename "$(git rev-parse --show-toplevel 2>/dev/null || echo "$PROJECT_DIR")")
  USER_YT="$HOME/.ytstack/projects/$SLUG"
  [ -d "$USER_YT" ] && YT_DIR="$USER_YT"
fi

[ -z "$YT_DIR" ] && exit 0

STATE_FILE="$YT_DIR/STATE.md"
[ ! -f "$STATE_FILE" ] && exit 0

# Parse stdin payload for task subject (contains our T## identifier if the
# team convention is "M###-S##-T## -- description")
TASK_JSON=$(cat)
TASK_SUBJECT=""
if command -v jq >/dev/null 2>&1; then
  TASK_SUBJECT=$(echo "$TASK_JSON" | jq -r '.tool_input.subject // .subject // empty' 2>/dev/null)
fi

[ -z "$TASK_SUBJECT" ] && exit 0

# Extract M###-S##-T## pattern from subject (if present)
TASK_ID=$(echo "$TASK_SUBJECT" | grep -oE 'M[0-9]{3}-S[0-9]{2}-T[0-9]{2}' | head -1)

if [ -z "$TASK_ID" ]; then
  # Task subject didn't follow our naming convention. Skip auto-summary.
  exit 0
fi

SUMMARY_FILE="$YT_DIR/$TASK_ID-SUMMARY.md"

# Don't overwrite an existing summary
if [ -f "$SUMMARY_FILE" ]; then
  exit 0
fi

TS=$(date -u +"%Y-%m-%dT%H:%M:%SZ")
PROJECT_NAME=$(sed -n 's/^name: *//p' "$YT_DIR/PROJECT.md" 2>/dev/null | head -1)

# Split task ID
MILESTONE=$(echo "$TASK_ID" | cut -d- -f1)
SLICE=$(echo "$TASK_ID" | cut -d- -f2)
TASK=$(echo "$TASK_ID" | cut -d- -f3)

cat > "$SUMMARY_FILE" <<EOF
---
milestone: $MILESTONE
slice: $SLICE
task: $TASK
project: ${PROJECT_NAME:-unknown}
closed: $TS
verification: auto-closed-by-hook
source: task-completed-hook
---

# $TASK_ID -- Summary (auto-generated)

**Note:** Auto-generated by the \`task-completed\` hook when the team marked this task complete. If you want a richer summary (Outcome, Deviations, Follow-ups, human-verified result), re-run \`/ytstack:summarize-task\` while \`active_task=$TASK\` is set in STATE.md.

## Outcome

Task completed per team's TaskUpdate at $TS. Original task subject: "$TASK_SUBJECT".

## Deviations from plan

(Not captured in auto-mode. Run summarize-task manually for a full report.)

## Follow-ups

(Not captured in auto-mode.)

## Verification

Task was marked complete by the Agent Teams lead or by self-claim. Check \`~/.claude/tasks/\` for the task-list state and the teammate's session transcript for execution details.
EOF

# Also flip the slice-plan checkbox if we can
SLICE_PLAN="$YT_DIR/$MILESTONE-$SLICE-PLAN.md"
if [ -f "$SLICE_PLAN" ]; then
  if sed --version >/dev/null 2>&1; then
    sed -i "s/^- \[ \] $TASK /- [x] $TASK /" "$SLICE_PLAN" 2>/dev/null || true
  else
    sed -i '' "s/^- \[ \] $TASK /- [x] $TASK /" "$SLICE_PLAN" 2>/dev/null || true
  fi
fi

exit 0

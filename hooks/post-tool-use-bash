#!/usr/bin/env bash
# ytstack PostToolUse hook for Bash
#
# Fires after every Bash tool call. If the call was a real, successful
# `git commit` whose HEAD subject carries the active task's commit ref, drop a
# draft T##-SUMMARY.md stub ONCE into the committing checkout's .ytstack so an
# interrupted task still leaves a closure artifact.
#
# Rules (M015 stub-once + M016 worktree-safe, DECISIONS 2026-05-31 and
# 2026-11-07):
#   - Checkout = payload `cwd` (fallback: this process's $PWD). NEVER
#     CLAUDE_PROJECT_DIR: it is pinned to the session-start dir and does not
#     follow the agent into a worktree, which is how stubs ended up in a shared
#     main checkout (#26/#27).
#   - Stub only when HEAD's subject matches `commit_ref_pattern` (PREFERENCES.md,
#     default `^M###-S##-T##:` rendered for the active task). A commit without
#     the ref is not this task's commit, whatever STATE.md says.
#   - Stub once; never re-write. summarize-task owns the durable commit list.
#   - Matcher accepts wrapper tokens (`rtk`, `sudo`, `command`, `env X=1`)
#     before `git commit`, still rejects echoes and `git log | grep commit`.
#
# Known limitation: a command that `cd`s elsewhere before committing is
# attributed to the payload cwd. Acceptable; summarize-task is the truth.
# Fail-open: exit 0 always.

set -uo pipefail
trap '' PIPE

. "$(cd "$(dirname "$0")" && pwd)/lib/git-ctx.sh"

yt_read_stdin

# Coordinate mode (issue #83, the marker of the coordinate preamble): a
# `gh run list --branch <default>` whose output shows a failed run is a red
# main; one note per distinct set of failed runs: run ytstack:lesson. Only
# the newest run of each workflow counts (gh lists newest first), in the
# tab-separated output (status, conclusion, title, workflow, ...) or a JSON
# array (conclusion, workflowName). With --repo/-R it must name origin.
red_main() {
  local sid="${YT_SESSION_ID:-}" sd br def out bad key jq_bin cmd
  local re_list='(^|[;&|()[:space:]])gh[[:space:]]+run[[:space:]]+list([[:space:]]|$)'
  local re_br='(--branch[=[:space:]]|-b[[:space:]]+)([A-Za-z0-9._/-]+)'
  local re_repo='(--repo[=[:space:]]|-R[[:space:]]+)([A-Za-z0-9._-]+/[A-Za-z0-9._-]+)' origin
  case "$sid" in ''|.|..|*[!A-Za-z0-9._-]*) return 0 ;; esac
  sd="$(yt_session_home)/$sid"
  [ -f "$sd/coordinate" ] || return 0
  cmd=$(printf '%s' "$YT_TOOL_CMD" | tr -d "\"'")
  [[ "$cmd" =~ $re_list ]] || return 0
  [[ "$cmd" =~ $re_br ]] || return 0
  br="${BASH_REMATCH[2]}"
  yt_git_ctx "${YT_CWD:-$PWD}"
  def=$(yt_standing_default_ref "$YT_TOPLEVEL"); def="${def#refs/remotes/origin/}"; def="${def#refs/heads/}"
  [ -n "$def" ] && [ "$br" = "$def" ] || return 0
  # Another repository's main is not this one's: --repo/-R must name origin.
  if [[ "$cmd" =~ $re_repo ]]; then
    origin=$(git -C "$YT_TOPLEVEL" remote get-url origin 2>/dev/null | sed -E 's#\.git$##; s#.*[:/]([^/:]+/[^/]+)$#\1#' | tr '[:upper:]' '[:lower:]')
    [ -n "$origin" ] && [ "$origin" = "$(printf '%s' "${BASH_REMATCH[2]}" | tr '[:upper:]' '[:lower:]')" ] || return 0
  fi
  jq_bin=$(yt_jq); [ -n "$jq_bin" ] || return 0
  out=$(printf '%s' "$YT_STDIN" | "$jq_bin" -r '(.tool_response | objects | .stdout) // "" | tostring' 2>/dev/null)
  # Only the newest run of each workflow counts (gh lists newest first).
  case "$out" in
    '['*) bad=$(printf '%s' "$out" | "$jq_bin" -c 'reduce .[] as $r ({}; ($r.workflowName // "") as $w | if has($w) then . else .[$w] = $r end) | .[] | select(.conclusion == "failure" or .conclusion == "timed_out" or .conclusion == "startup_failure")' 2>/dev/null) ;;
    *) bad=$(printf '%s\n' "$out" | awk -F '\t' 'NF >= 7 && !seen[$4]++ && $1 == "completed" && ($2 == "failure" || $2 == "timed_out" || $2 == "startup_failure")') ;;
  esac
  [ -n "$bad" ] || return 0
  key=$(printf '%s' "$bad" | cksum | tr -d ' ')
  grep -qxF -- "$key" "$sd/red-main-said" 2>/dev/null && return 0
  printf '%s\n' "$key" >> "$sd/red-main-said" 2>/dev/null || return 0
  printf '%s' "ytstack: gh run list shows a failed run on $def, the default branch. A red main blocks every lane that merges after it: invoke ytstack:lesson before the next dispatch (area ci, the check, the commit, the lane that merged it) and dispatch the repair as a lane (ytstack:coordinate Step 7, \"A red main\")." \
    | "$jq_bin" -Rs '{hookSpecificOutput: {hookEventName: "PostToolUse", additionalContext: .}}' 2>/dev/null
}
red_main

# Only successful calls (exit code absent or 0).
case "${YT_TOOL_EXIT:-0}" in 0|"") ;; *) exit 0 ;; esac

# Real `git commit` after a command separator, optionally behind wrapper tokens.
_WRAP='((rtk|sudo|command|env([[:space:]]+[A-Za-z_][A-Za-z0-9_]*=[^[:space:]]*)*)[[:space:]]+)*'
_GIT_COMMIT_RE="(^|[;&|()])[[:space:]]*${_WRAP}git[[:space:]]+commit([[:space:]]|\$)"
if ! [[ "$YT_TOOL_CMD" =~ $_GIT_COMMIT_RE ]]; then
  exit 0
fi

yt_git_ctx "${YT_CWD:-$PWD}"
[ "$YT_IS_GIT" = yes ] || exit 0
YT_DIR=$(yt_resolve_yt_dir)
[ -z "$YT_DIR" ] && exit 0

STATE_FILE="$YT_DIR/STATE.md"
[ -f "$STATE_FILE" ] || exit 0
get_field() { sed -n "s/^$1: *//p" "$STATE_FILE" 2>/dev/null | head -1; }
CURRENT_MILESTONE=$(get_field current_milestone)
ACTIVE_SLICE=$(get_field active_slice)
ACTIVE_TASK=$(get_field active_task)
case "$ACTIVE_TASK" in ""|none) exit 0 ;; esac
case "$ACTIVE_SLICE" in ""|none) exit 0 ;; esac

TASK_REF="$CURRENT_MILESTONE-$ACTIVE_SLICE-$ACTIVE_TASK"

# Commit-ref pattern (shared with summarize-task): PREFERENCES.md
# `commit_ref_pattern`, default `^M###-S##-T##:`, tokens rendered by the lib.
PATTERN=$(yt_commit_ref_pattern "$YT_DIR" "$CURRENT_MILESTONE" "$ACTIVE_SLICE" "$ACTIVE_TASK")

SUBJECT=$(git -C "$YT_TOPLEVEL" log -1 --pretty=%s 2>/dev/null || echo "")
if ! [[ "$SUBJECT" =~ $PATTERN ]]; then
  exit 0
fi

# The milestone's directory: flat, or milestones/M###/ once it lives there (#70).
SUMMARY_FILE=$(yt_artifact_path "$YT_DIR" "$TASK_REF-SUMMARY.md")
[ -f "$SUMMARY_FILE" ] && exit 0   # stub-once

COMMIT_SHA=$(git -C "$YT_TOPLEVEL" rev-parse --short HEAD 2>/dev/null || echo unknown)
TS=$(date -u +"%Y-%m-%dT%H:%M:%SZ")
PROJECT_NAME=$(sed -n 's/^name: *//p' "$YT_DIR/PROJECT.md" 2>/dev/null | head -1)

cat > "$SUMMARY_FILE" 2>/dev/null <<EOF
---
milestone: $CURRENT_MILESTONE
slice: $ACTIVE_SLICE
task: $ACTIVE_TASK
project: ${PROJECT_NAME:-unknown}
closed: draft
verification: pending
source: post-tool-use-bash-draft
worktree: $YT_TOPLEVEL
---

# $TASK_REF -- Summary (draft)

Auto-draft created by the \`post-tool-use-bash\` hook on the first commit of this task that carried its commit ref. Run \`/ytstack:summarize-task\` to fill in Outcome / Deviations / Follow-ups / Verification and the full commit list. This stub is written once and never re-touched by the hook.

First commit of this task: \`$COMMIT_SHA\` -- $SUBJECT ($TS)

## Outcome

(Fill in when task is done.)

## Deviations from plan

(Fill in when task is done.)

## Follow-ups

(Fill in when task is done.)

## Verification

(Fill in when task is done.)
EOF

exit 0

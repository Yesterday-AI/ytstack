    {"type":"text","id":"ex2_note","x":540,"y":1347,"width":700,"height":60,"text":"Dispatches Agent Team, one teammate per slice, each in its own fresh\n200k context. Replaces GSD's subprocess model.\nRequires CLAUDE_CODE_EXPERIMENTAL_AGENT_TEAMS=1 + CC v2.1.32+.","originalText":"Dispatches Agent Team, one teammate per slice, each in its own fresh\n200k context. Replaces GSD's subprocess model.\nRequires CLAUDE_CODE_EXPERIMENTAL_AGENT_TEAMS=1 + CC v2.1.32+.","fontSize":12,"fontFamily":3,"textAlign":"left","verticalAlign":"middle","strokeColor":"#737373","backgroundColor":"transparent","fillStyle":"solid","strokeWidth":1,"strokeStyle":"solid","roughness":0,"opacity":100,"angle":0,"seed":940005,"version":1,"versionNonce":940006,"isDeleted":false,"groupIds":[],"boundElements":null,"link":null,"locked":false,"containerId":null,"lineHeight":1.3},

    {"type":"text","id":"foot","x":120,"y":1460,"width":1400,"height":40,"text":"Skill selection is semantic: the agent matches user intent against each skill's description: field.\nNo phrase-lookup. Sharpen the description if the agent picks wrong; do not add keyword lists (design principle #6).","originalText":"Skill selection is semantic: the agent matches user intent against each skill's description: field.\nNo phrase-lookup. Sharpen the description if the agent picks wrong; do not add keyword lists (design principle #6).","fontSize":13,"fontFamily":3,"textAlign":"left","verticalAlign":"top","strokeColor":"#0A0A0A","backgroundColor":"transparent","fillStyle":"solid","strokeWidth":1,"strokeStyle":"solid","roughness":0,"opacity":100,"angle":0,"seed":950001,"version":1,"versionNonce":950002,"isDeleted":false,"groupIds":[],"boundElements":null,"link":null,"locked":false,"containerId":null,"lineHeight":1.4}


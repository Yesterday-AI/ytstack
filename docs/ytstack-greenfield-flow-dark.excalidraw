    {"type":"text","id":"note_title","x":1330,"y":480,"width":300,"height":24,"text":"KEY IDEA","originalText":"KEY IDEA","fontSize":18,"fontFamily":3,"textAlign":"left","verticalAlign":"top","strokeColor":"#FC4E14","backgroundColor":"transparent","fillStyle":"solid","strokeWidth":1,"strokeStyle":"solid","roughness":0,"opacity":100,"angle":0,"seed":1510001,"version":1,"versionNonce":1510002,"isDeleted":false,"groupIds":[],"boundElements":null,"link":null,"locked":false,"containerId":null,"lineHeight":1.25},
    {"type":"text","id":"note_body","x":1330,"y":520,"width":440,"height":220,"text":"Skill selection is SEMANTIC.\nThe hook injects one directive (1%-rule + Red Flags);\nthe agent matches user intent against each\nskill's description: field. No keyword list,\nno trigger map.\n\nEvery process step PRODUCES an artifact\non disk (green rectangles on the right).\nThat artifact is the hand-off contract to\nthe next step -- no verbal memory needed\nbetween sessions.\n\nThe task loop is the heartbeat:\nplan -> test -> verify -> summarize,\nwith systematic-debugging as the failure\ndetour. reassess-roadmap runs at slice\nboundaries, not mid-slice.","originalText":"Skill selection is SEMANTIC.\nThe hook injects one directive (1%-rule + Red Flags);\nthe agent matches user intent against each\nskill's description: field. No keyword list,\nno trigger map.\n\nEvery process step PRODUCES an artifact\non disk (green rectangles on the right).\nThat artifact is the hand-off contract to\nthe next step -- no verbal memory needed\nbetween sessions.\n\nThe task loop is the heartbeat:\nplan -> test -> verify -> summarize,\nwith systematic-debugging as the failure\ndetour. reassess-roadmap runs at slice\nboundaries, not mid-slice.","fontSize":13,"fontFamily":3,"textAlign":"left","verticalAlign":"top","strokeColor":"#F5F5F5","backgroundColor":"transparent","fillStyle":"solid","strokeWidth":1,"strokeStyle":"solid","roughness":0,"opacity":100,"angle":0,"seed":1510003,"version":1,"versionNonce":1510004,"isDeleted":false,"groupIds":[],"boundElements":null,"link":null,"locked":false,"containerId":null,"lineHeight":1.4}

  ],

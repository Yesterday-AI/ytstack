#!/usr/bin/env python3
"""ytstack-check — validate ytstack plugin artifacts against UX contracts.

Run from the plugin root (or pass path):
    bin/ytstack-check
    bin/ytstack-check /path/to/ytstack
    bin/ytstack-check --strict      # warnings become failures
    bin/ytstack-check --quiet       # only print on failure

Exit codes: 0 = pass, 1 = fail, 2 = warnings only (non-strict).

Checks against the contracts in docs/ux/:
  - skill-structure.md
  - agent-structure.md
  - askuserquestion-format.md
  - writing-style.md
"""

import os
import re
import sys
from pathlib import Path

# Banned vocabulary / phrases were dropped 2026-04-24: those rules were
# ytstack-original scope creep (not requested; not inherited from gstack /
# superpowers / GSD). Only the em-dash punctuation rule is kept because it
# is a concrete macOS autocorrect hazard, not a style opinion.


# ---------- helpers ----------

def find_plugin_root(arg):
    """Locate the ytstack plugin root (has .claude-plugin/plugin.json)."""
    start = Path(arg) if arg else Path.cwd()
    start = start.resolve()
    for p in [start, *start.parents]:
        if (p / ".claude-plugin" / "plugin.json").is_file():
            return p
    sys.stderr.write(f"error: no .claude-plugin/plugin.json found from {start}\n")
    sys.exit(1)


def parse_frontmatter(path):
    """Extract YAML frontmatter (between --- markers) as a plain dict.

    Deliberately naive — handles simple key: value, multi-line block-scalars
    (`description: |`), list items (`- value`), and exactly one level of
    nested map for `metadata:` (M019: ytstack's own keys live there). No
    flow style.
    """
    text = path.read_text(encoding="utf-8")
    m = re.match(r"^---\n(.*?)\n---\n", text, re.DOTALL)
    if not m:
        return None, text
    raw = m.group(1)
    body = text[m.end():]

    fm = {}
    current_key = None
    current_list = None
    current_block = None
    current_map = None      # dict being filled for `metadata:`
    map_list_key = None     # list key inside the map (`  triggers:`)

    for line in raw.split("\n"):
        # Block scalar continuation (description: |)
        if current_block is not None:
            if line.startswith("  ") or line == "":
                current_block.append(line[2:] if line.startswith("  ") else "")
                continue
            else:
                fm[current_key] = "\n".join(current_block).rstrip()
                current_block = None
                current_key = None

        # Nested map continuation (metadata:)
        if current_map is not None:
            nm = re.match(r"^  ([a-zA-Z_][a-zA-Z0-9_-]*):\s*(.*)$", line)
            if nm:
                k, v = nm.group(1), nm.group(2)
                if v == "":
                    map_list_key = k
                    current_map[k] = []
                else:
                    map_list_key = None
                    current_map[k] = v.strip()
                continue
            if map_list_key is not None and line.startswith("    - "):
                current_map[map_list_key].append(line[6:].strip())
                continue
            current_map = None
            map_list_key = None
            current_key = None

        # List item continuation
        if current_list is not None:
            if line.startswith("  - "):
                current_list.append(line[4:].strip())
                continue
            else:
                fm[current_key] = current_list
                current_list = None
                current_key = None

        # Key: value on one line, or key: | / key: (start of list or map)
        km = re.match(r"^([a-zA-Z_][a-zA-Z0-9_-]*):\s*(.*)$", line)
        if km:
            key, val = km.group(1), km.group(2)
            if val == "|":
                current_key = key
                current_block = []
            elif val == "" and key == "metadata":
                current_key = key
                current_map = {}
                fm[key] = current_map
            elif val == "":
                # Either empty (skip) or list follows
                current_key = key
                current_list = []
            else:
                fm[key] = val.strip()

    # Flush trailing state
    if current_block is not None:
        fm[current_key] = "\n".join(current_block).rstrip()
    if current_list is not None and current_list:
        fm[current_key] = current_list

    return fm, body


# ytstack's own frontmatter keys. Agent Skills spec: only name, description,
# license, compatibility, metadata, allowed-tools are portable; everything
# else hard-errors on packaging/upload. So tier / version / kind / triggers
# live under `metadata:` (M019-S01-T01). Top-level is read as legacy.
YT_META_KEYS = ("tier", "version", "kind", "triggers")


def skill_meta(fm):
    """Merged view of ytstack keys: metadata.* first, top-level as fallback."""
    meta = fm.get("metadata") if isinstance(fm.get("metadata"), dict) else {}
    out = {}
    for k in YT_META_KEYS:
        if k in meta:
            out[k] = meta[k]
        elif k in fm:
            out[k] = fm[k]
    return out


def legacy_meta_keys(fm):
    return [k for k in YT_META_KEYS if k in fm]


# Phrases that mean the description summarises the body instead of saying
# when to trigger (superpowers writing-skills: "never summarise the workflow
# in the description"; mattpocock: cut identity the body already carries).
DESC_PROCEDURE_PHRASES = (
    r"RED-GREEN",
    r"\bStep \d",
    r"\b(?:four|six|five|three) (?:modes|forcing questions|phases)\b",
    r"Thin ytstack wrapper around",
    r"(?:^|\s)\d\)\s",          # 1) 2) numbered list
    r"\b\d\.\s+[A-Z][a-z]+.*\b\d\.\s+[A-Z]",  # "1. Foo ... 2. Bar"
)


# ---------- check: skill ----------

def check_skill(path, root):
    fails = []
    warns = []
    name = path.parent.name

    fm, body = parse_frontmatter(path)
    if fm is None:
        fails.append(f"{path}: missing frontmatter")
        return fails, warns

    # Required frontmatter
    if fm.get("name") != name:
        fails.append(
            f"{path}: frontmatter name '{fm.get('name')}' != directory '{name}'"
        )
    if not fm.get("description"):
        fails.append(f"{path}: missing description")

    # Description contract (M019-S01-T03): trigger statement, not a procedure
    # summary; spec max 1,024 chars (listing truncates description +
    # when_to_use at 1,536). Third person, what + when + when-not.
    desc = fm.get("description") or ""
    if isinstance(desc, str):
        if len(desc) > 1024:
            fails.append(
                f"{path}: description is {len(desc)} chars, spec max 1,024"
            )
        hits = [p for p in DESC_PROCEDURE_PHRASES if re.search(p, desc)]
        if hits:
            warns.append(
                f"{path}: description reads like a procedure summary "
                f"({', '.join(hits)}); keep it to what + when + when-not"
            )

    # metadata: contract (M019-S01-T01)
    meta = skill_meta(fm)
    legacy = legacy_meta_keys(fm)
    if legacy:
        warns.append(
            f"{path}: legacy top-level {', '.join(legacy)} -- move under metadata: "
            f"(Agent Skills spec; packaging/upload rejects unknown top-level keys)"
        )
    missing_meta = [k for k in ("tier", "version") if k not in meta]
    if missing_meta:
        warns.append(
            f"{path}: missing metadata.{' / metadata.'.join(missing_meta)}"
        )

    # kind: directive skills are meta-primers (like using-ytstack);
    # kind: reference skills are methodology / lookup references (no
    # numbered procedure to run). Neither is procedural, so both skip
    # the structural-section checks (Checklist / Terminal State / ...).
    kind = meta.get("kind")
    is_directive = kind == "directive"
    is_reference = kind == "reference"
    if (is_directive or is_reference) and "user-invocable" not in fm:
        warns.append(
            f"{path}: kind: {kind} without an explicit user-invocable flag "
            f"(directives: false, references: true)"
        )

    # Thin-wrapper skills inline a vendor SKILL.md via the shell-exec
    # injection pattern (```!  cat .../vendor/.../SKILL.md  ```). The
    # structural contract (Checklist / Terminal State / Preamble /
    # Procedure) lives in the vendored file, not in the wrapper.
    is_thin_wrapper = bool(
        re.search(r"vendor/[\w/-]+?/SKILL\.md", body)
        and re.search(r"^```!\s*$", body, re.MULTILINE)
    )

    if is_thin_wrapper:
        # Thin wrappers require "ytstack invocation notes" (where the
        # wrapper adds its value) + em-dash hygiene. No banned-words gate.
        if not re.search(
            r"^##\s+ytstack invocation notes\b", body, re.MULTILINE | re.IGNORECASE
        ):
            warns.append(
                f"{path}: thin-wrapper is missing '## ytstack invocation notes' "
                f"section (where the wrapper adds its value)"
            )
        for i, line in enumerate(body.split("\n"), 1):
            if "—" in line and not line.strip().startswith("|"):
                warns.append(f"{path}:{i}: em-dash in prose (use comma/period/...)")
        return fails, warns

    if is_directive or is_reference:
        # Directives (meta-primers) and references (methodology / lookup)
        # get em-dash hygiene but skip structural-section requirements
        # (Checklist / Terminal State / Preamble / Procedure assume a
        # numbered procedure these skill classes do not have).
        for i, line in enumerate(body.split("\n"), 1):
            if "—" in line and not line.strip().startswith("|"):
                warns.append(f"{path}:{i}: em-dash in prose (use comma/period/...)")
        return fails, warns

    # Required body sections (per docs/ux/skill-structure.md)
    required_sections = [
        (r"^##\s+Checklist\b", "Checklist"),
        (r"^##\s+Terminal State\b", "Terminal State"),
    ]
    recommended_sections = [
        (r"^##\s+Preamble\b", "Preamble"),
        (r"^##\s+Procedure\b", "Procedure"),
        (r"^##\s+Process Flow\b", "Process Flow"),
        (r"^##\s+Anti-Pattern\b", "Anti-Pattern"),
    ]

    for pattern, label in required_sections:
        if not re.search(pattern, body, re.MULTILINE):
            fails.append(f"{path}: missing required section '## {label}'")

    for pattern, label in recommended_sections:
        if not re.search(pattern, body, re.MULTILINE):
            warns.append(f"{path}: missing recommended section '## {label}'")

    # Checklist must force TodoWrite discipline
    if re.search(r"^##\s+Checklist\b", body, re.MULTILINE):
        checklist_block = re.split(r"^## ", body, flags=re.MULTILINE)
        checklist_text = next(
            (b for b in checklist_block if b.startswith("Checklist")), ""
        )
        if "MUST" not in checklist_text:
            warns.append(
                f"{path}: Checklist does not contain 'MUST' (TodoWrite-discipline)"
            )

    # Em-dashes in prose (macOS autocorrect hazard). No banned-word gate.
    for i, line in enumerate(body.split("\n"), 1):
        if "—" in line and not line.strip().startswith("|"):  # allow in tables
            warns.append(f"{path}:{i}: em-dash in prose (use comma/period/...)")

    return fails, warns


# ---------- check: agent ----------

def check_agent(path, root):
    fails = []
    warns = []
    name = path.stem

    fm, body = parse_frontmatter(path)
    if fm is None:
        fails.append(f"{path}: missing frontmatter")
        return fails, warns

    # Required fields (per docs/ux/agent-structure.md)
    for field in ("name", "description", "model", "tools", "skills"):
        if field not in fm:
            fails.append(f"{path}: missing required frontmatter field '{field}'")

    if fm.get("name") != name:
        fails.append(
            f"{path}: frontmatter name '{fm.get('name')}' != filename '{name}'"
        )

    desc = fm.get("description", "")
    example_count = desc.count("<example>") if isinstance(desc, str) else 0
    if example_count < 2:
        fails.append(
            f"{path}: description has {example_count} <example> blocks (need >=2)"
        )

    # Skills must reference existing ytstack skills
    skills = fm.get("skills", [])
    if isinstance(skills, list):
        for skill_ref in skills:
            if not skill_ref.startswith("ytstack:"):
                warns.append(
                    f"{path}: skill '{skill_ref}' not ytstack-namespaced"
                )
                continue
            skill_name = skill_ref.replace("ytstack:", "", 1)
            if not (root / "skills" / skill_name / "SKILL.md").is_file():
                fails.append(
                    f"{path}: skill '{skill_ref}' not found at skills/{skill_name}/SKILL.md"
                )

    # Subagent contract fields (M019-S04): optional, but valid when present.
    iso = fm.get("isolation")
    if iso is not None and iso != "worktree":
        fails.append(f"{path}: isolation '{iso}' (only 'worktree' exists)")
    mem = fm.get("memory")
    if mem is not None and mem not in ("user", "project", "local"):
        fails.append(f"{path}: memory '{mem}' (user|project|local)")
    for bad_key in ("hooks", "mcpServers", "permissionMode"):
        if bad_key in fm:
            warns.append(f"{path}: '{bad_key}' is ignored for plugin subagents")
    if name == "implementer" and iso != "worktree":
        warns.append(f"{path}: implementer should run with isolation: worktree (M019-S04 execution model)")

    # Body sections
    if not re.search(r"[Dd]oes? NOT|do NOT", body):
        fails.append(
            f"{path}: missing 'does NOT' / 'do NOT' section content"
        )
    if not re.search(r"[Ss]ubagent context|SUBAGENT-STOP", body):
        warns.append(f"{path}: no subagent-context note found")

    # Line count
    line_count = len(path.read_text(encoding="utf-8").split("\n"))
    if line_count > 200:
        fails.append(f"{path}: {line_count} lines (limit 200)")
    elif line_count > 100:
        warns.append(f"{path}: {line_count} lines (soft limit 100)")

    return fails, warns


# ---------- check: cross-references ----------

def check_cross_refs(root):
    fails = []
    warns = []

    # spawn-milestone-team → architect/implementer/verifier
    smt = root / "skills" / "spawn-milestone-team" / "SKILL.md"
    if smt.is_file():
        smt_text = smt.read_text(encoding="utf-8")
        for role in ("architect", "implementer", "verifier"):
            if role in smt_text:
                if not (root / "agents" / f"{role}.md").is_file():
                    fails.append(
                        f"spawn-milestone-team references '{role}' but "
                        f"agents/{role}.md missing"
                    )

    # Wrappers: hard-coded vendor path references
    # Look for vendor/<name>/... in each wrapper SKILL.md
    for skill_md in (root / "skills").glob("*/SKILL.md"):
        text = skill_md.read_text(encoding="utf-8")
        for m in re.finditer(
            r"vendor/(superpowers|gstack)[^\s\"`)]*", text
        ):
            ref = m.group(0).rstrip(".,:;")
            # Trim anything after /SKILL.md if present
            if "SKILL.md" in ref:
                check_path = root / ref
                if not check_path.is_file():
                    fails.append(
                        f"{skill_md}: references {ref} but file missing "
                        f"(subtree not added?)"
                    )

    return fails, warns


# ---------- check: vendor sibling-skill refs (dangling cross-ref) ----------

def check_vendor_sibling_refs(root):
    """For each ytstack wrapper that cat-inlines a vendor SKILL.md, scan the
    vendor content for sibling-skill mentions (backtick-quoted names or
    slash-commands). Flag sibling names that ytstack does not also wrap:
    the vendor instruction will tell the agent to 'run `foo`' but ytstack
    users cannot because we do not ship that wrapper.

    Surface level: warn per dangling ref with file:context snippet. The
    human then decides per case (add wrapper, accept gap, rewrite prose).
    """
    fails = []
    warns = []

    # ytstack-shipped skill names (non-vendor-lookalike)
    ytstack_skills = {
        d.name for d in (root / "skills").iterdir()
        if d.is_dir() and (d / "SKILL.md").is_file()
    }

    # Vendor-catalog roots we recognize
    vendor_bases = []
    for rel in ("vendor/gstack", "vendor/superpowers/skills"):
        vb = root / rel
        if vb.is_dir():
            siblings = {
                d.name for d in vb.iterdir()
                if d.is_dir() and (d / "SKILL.md").is_file()
            }
            vendor_bases.append((vb, siblings))

    if not vendor_bases:
        return fails, warns

    # For each ytstack wrapper, resolve which vendor SKILL.md it inlines and scan it
    for wrapper in sorted((root / "skills").glob("*/SKILL.md")):
        text = wrapper.read_text(encoding="utf-8")
        # Find every vendor SKILL.md path mentioned in the wrapper body.
        # Robust against shell expansion boilerplate (env-var defaults with
        # spaces, quote variations, etc) because we match the path segment
        # directly without trying to parse the surrounding `cat "..."`.
        cat_refs = sorted(set(re.findall(
            r"vendor/[\w/-]+?/SKILL\.md",
            text,
        )))
        for vendor_rel in cat_refs:
            vendor_path = root / vendor_rel
            if not vendor_path.is_file():
                continue  # already flagged elsewhere
            # Identify catalog + sibling set
            sibling_set = None
            catalog_base = None
            for vb, siblings in vendor_bases:
                try:
                    vendor_path.relative_to(vb)
                    sibling_set = siblings
                    catalog_base = vb
                    break
                except ValueError:
                    continue
            if sibling_set is None:
                continue
            self_name = vendor_path.parent.name
            vendor_text = vendor_path.read_text(encoding="utf-8")
            seen_in_this_vendor = set()
            for sibling in sibling_set:
                if sibling == self_name:
                    continue
                # Narrow match: backtick-quoted name OR /name slash-command.
                # Prose mentions of kebab-words without punctuation do not match.
                pattern = rf"(`{re.escape(sibling)}`|/{re.escape(sibling)}(?:\b|$))"
                if re.search(pattern, vendor_text):
                    if sibling in ytstack_skills:
                        continue  # fine -- ytstack wraps it too
                    seen_in_this_vendor.add(sibling)
            for sibling in sorted(seen_in_this_vendor):
                rel_vendor = vendor_path.relative_to(root)
                rel_wrapper = wrapper.relative_to(root)
                warns.append(
                    f"{rel_wrapper}: vendor content at {rel_vendor} references "
                    f"sibling skill '{sibling}' but ytstack does not ship a wrapper "
                    f"for it (consider: wrap it, or strip the ref in docs, or accept gap)"
                )

    return fails, warns


# ---------- check: resolver contract (M016, DECISIONS 2026-11-07) ----------

# Code lines only: a line whose first non-blank char is `#` is a comment.
_COMMENT_RE = re.compile(r"^\s*#")

# (regex, scope, hint) -- scope: "all" | "hooks"
_BANNED = [
    (re.compile(r"\[ -d \.git \]"), "all",
     "Git detection must use `git rev-parse --is-inside-work-tree` (linked worktrees have a .git FILE); use hooks/lib/git-ctx.sh"),
    (re.compile(r'basename "\$\(git rev-parse --show-toplevel'), "all",
     "basename slugs collide across repos; use YT_REPO_KEY from git-ctx.sh (basename only for display of a resolved path)"),
    (re.compile(r"CLAUDE_PROJECT_DIR"), "hooks",
     "CLAUDE_PROJECT_DIR is pinned to the session-start dir and does not follow worktrees; resolve from the payload cwd via git-ctx.sh"),
    (re.compile(r"~/\.ytstack/\.|\$HOME/\.ytstack/\."), "all",
     "sentinel files under ~/.ytstack/. are retired; record state in PROJECT.md frontmatter"),
]

_FENCE_OPEN_RE = re.compile(r"^```(bash|sh|!)\s*$")


def _code_lines(text):
    """Yield (lineno, line) for non-comment lines."""
    for i, line in enumerate(text.split("\n"), start=1):
        if _COMMENT_RE.match(line):
            continue
        yield i, line


def _first_shell_preamble(text):
    """Return the body of the first ```bash / ```! fenced block, or None."""
    lines = text.split("\n")
    for i, line in enumerate(lines):
        if _FENCE_OPEN_RE.match(line):
            body = []
            for l in lines[i + 1:]:
                if l.strip() == "```":
                    break
                body.append(l)
            return "\n".join(body)
    return None


def check_resolver_contract(root):
    fails = []
    warns = []

    targets = []  # (path, scope)
    for p in sorted((root / "skills").glob("*/SKILL.md")):
        targets.append((p, "skills"))
    hooks_dir = root / "hooks"
    if hooks_dir.is_dir():
        for p in sorted(hooks_dir.iterdir()):
            if p.is_file() and p.suffix != ".json":
                targets.append((p, "hooks"))

    for path, scope in targets:
        rel = path.relative_to(root)
        text = path.read_text(encoding="utf-8", errors="replace")
        for lineno, line in _code_lines(text):
            for rx, rx_scope, hint in _BANNED:
                if rx_scope == "hooks" and scope != "hooks":
                    continue
                if rx.search(line):
                    fails.append(f"{rel}:{lineno}: banned pattern `{rx.pattern}` -- {hint}")
        if scope == "skills" and ("\n## Preamble" in text or "\n```!" in text):
            # Only skills with an executable preamble (lifecycle skills and
            # render-time wrappers); kind:reference skills with curl examples
            # in ```bash blocks are not resolvers.
            pre = _first_shell_preamble(text)
            if pre is not None and "hooks/lib/git-ctx.sh" not in pre:
                fails.append(f"{rel}: shell preamble does not use the shared resolver (source hooks/lib/git-ctx.sh via ${{CLAUDE_SKILL_DIR}}/../../hooks/lib/git-ctx.sh)")
        if scope == "hooks" and "lib/git-ctx.sh" not in text:
            fails.append(f"{rel}: hook does not source hooks/lib/git-ctx.sh")

    # Version agreement between plugin.json and marketplace.json
    try:
        import json
        pj = json.loads((root / ".claude-plugin" / "plugin.json").read_text(encoding="utf-8"))
        mp = root / ".claude-plugin" / "marketplace.json"
        if mp.is_file():
            mj = json.loads(mp.read_text(encoding="utf-8"))
            entries = mj.get("plugins") or []
            for e in entries:
                if e.get("name") == pj.get("name") and e.get("version") not in (None, pj.get("version")):
                    warns.append(
                        f".claude-plugin/marketplace.json: entry version {e.get('version')!r} != plugin.json version {pj.get('version')!r} (plugin.json wins at install; align both)"
                    )
    except Exception as exc:  # noqa: BLE001 -- report, never crash the checker
        warns.append(f"version agreement check skipped: {exc}")

    return fails, warns


# ---------- check: inlined vendor text leaks (M017) ----------

_NS_LEAK_RE = re.compile(r"\bsuperpowers:([a-z0-9-]+)")
_REL_LINK_RE = re.compile(r"\]\(([A-Za-z0-9_./-]+\.md)(?:#[^)]*)?\)")
_INLINE_REF_RE = re.compile(r"vendor/[\w/-]+?/SKILL\.md")


def check_inline_leaks(root):
    """Wrappers that cat-inline a vendor SKILL.md render upstream text inside
    ytstack. Upstream may reference its own namespace (`superpowers:foo`) or
    relative files (`[x](notes.md)`) that do not resolve in a ytstack session.
    Require a `## Namespace note` in the wrapper that names each leaked token
    and says where relative links resolve."""
    fails = []
    warns = []
    for wrapper in sorted((root / "skills").glob("*/SKILL.md")):
        text = wrapper.read_text(encoding="utf-8", errors="replace")
        rel_wrapper = wrapper.relative_to(root)
        has_note = "## Namespace note" in text
        for vendor_rel in sorted(set(_INLINE_REF_RE.findall(text))):
            vendor_path = root / vendor_rel
            if not vendor_path.is_file():
                continue  # flagged by check_cross_refs
            vtext = vendor_path.read_text(encoding="utf-8", errors="replace")
            for tok in sorted(set(m.group(0) for m in _NS_LEAK_RE.finditer(vtext))):
                if not (has_note and tok in text):
                    fails.append(
                        f"{rel_wrapper}: inlined vendor text ({vendor_rel}) references `{tok}` "
                        f"but the wrapper has no '## Namespace note' translating it to ytstack:"
                    )
            rel_links = sorted(set(
                m.group(1) for m in _REL_LINK_RE.finditer(vtext)
                if not m.group(1).startswith(("http://", "https://", "/"))
            ))
            for link in rel_links:
                if not (has_note and "resolve under" in text):
                    fails.append(
                        f"{rel_wrapper}: inlined vendor text ({vendor_rel}) links relatively to `{link}` "
                        f"but the wrapper has no '## Namespace note' saying where relative links resolve"
                    )
    return fails, warns


# ---------- check: gstack wrappers (installed dependency contract, M017) ----------

_GSTACK_WRAPPERS = ("office-hours", "plan-ceo-review", "plan-eng-review", "retro", "ship", "document-release")


def check_gstack_wrappers(root):
    """gstack is an installed, tag-pinned dependency (DECISIONS 2026-11-07).
    Each wrapper must run the precheck, carry the install command, invoke the
    installed skill through the Skill tool, and never inline vendor/gstack."""
    fails = []
    warns = []
    for name in _GSTACK_WRAPPERS:
        path = root / "skills" / name / "SKILL.md"
        if not path.is_file():
            continue
        text = path.read_text(encoding="utf-8", errors="replace")
        rel = path.relative_to(root)
        if "vendor/gstack" in "\n".join(l for l in text.split("\n") if not _COMMENT_RE.match(l)):
            fails.append(f"{rel}: gstack wrapper references vendor/gstack (gstack is an installed dependency, never inlined)")
        if "yt_gstack_ctx" not in text:
            fails.append(f"{rel}: gstack wrapper lacks the yt_gstack_ctx precheck")
        if "GSTACK_INSTALL_CMD" not in text:
            fails.append(f"{rel}: gstack wrapper lacks GSTACK_INSTALL_CMD (the stop message must carry the pinned install command)")
        if f"Invoke the Skill tool with `{name}`" not in text:
            fails.append(f"{rel}: gstack wrapper must say \"Invoke the Skill tool with `{name}`\"")
        if "## HARD-GATE" not in text:
            fails.append(f"{rel}: gstack wrapper lacks a HARD-GATE section")
    return fails, warns


# ---------- main ----------

def main():
    args = sys.argv[1:]
    strict = "--strict" in args
    quiet = "--quiet" in args
    path_args = [a for a in args if not a.startswith("--")]
    root_arg = path_args[0] if path_args else None

    root = find_plugin_root(root_arg)

    all_fails = []
    all_warns = []

    # Skills
    for skill_md in sorted((root / "skills").glob("*/SKILL.md")):
        f, w = check_skill(skill_md, root)
        all_fails.extend(f)
        all_warns.extend(w)

    # Agents (may not exist — that's fine)
    agents_dir = root / "agents"
    if agents_dir.is_dir():
        for agent_md in sorted(agents_dir.glob("*.md")):
            f, w = check_agent(agent_md, root)
            all_fails.extend(f)
            all_warns.extend(w)

    # Cross-refs
    f, w = check_cross_refs(root)
    all_fails.extend(f)
    all_warns.extend(w)

    # Vendor sibling-skill dangling refs
    f, w = check_vendor_sibling_refs(root)
    all_fails.extend(f)
    all_warns.extend(w)

    # Resolver contract (M016): banned patterns, shared lib, version agreement
    f, w = check_resolver_contract(root)
    all_fails.extend(f)
    all_warns.extend(w)

    # Inlined vendor text leaks (M017): namespace refs + relative links need a Namespace note
    f, w = check_inline_leaks(root)
    all_fails.extend(f)
    all_warns.extend(w)

    # gstack wrappers (M017): installed-dependency contract
    f, w = check_gstack_wrappers(root)
    all_fails.extend(f)
    all_warns.extend(w)

    # --tests: run the shell test suites (tests/run-all.sh) and fold the result in
    if "--tests" in args:
        import subprocess
        runner = root / "tests" / "run-all.sh"
        if runner.is_file():
            proc = subprocess.run(["bash", str(runner)], capture_output=True, text=True)
            if not quiet:
                sys.stdout.write(proc.stdout)
            if proc.returncode != 0:
                failed = [l.strip() for l in proc.stdout.splitlines() if l.strip().startswith("FAIL ")]
                all_fails.append(f"tests: run-all.sh exit {proc.returncode}: {'; '.join(failed) or proc.stderr.strip()[:200]}")
        else:
            all_warns.append("tests: tests/run-all.sh not found")

    # Report
    if not quiet or all_fails or (strict and all_warns):
        if all_fails:
            print(f"FAIL: {len(all_fails)} error(s)")
            for line in all_fails:
                print(f"  [fail] {line}")
        if all_warns:
            tag = "fail" if strict else "warn"
            print(f"{'WARNINGS promoted to errors' if strict else 'WARNINGS'}: {len(all_warns)}")
            for line in all_warns:
                print(f"  [{tag}] {line}")
        if not all_fails and not all_warns:
            print("OK: all skills + agents pass ytstack-check")
        elif not all_fails and all_warns and not strict:
            print(f"OK (with {len(all_warns)} warning[s])")

    if all_fails:
        sys.exit(1)
    if strict and all_warns:
        sys.exit(1)
    if all_warns:
        sys.exit(2)
    sys.exit(0)


if __name__ == "__main__":
    main()

#!/usr/bin/env bash
# ytstack-gstack-diff -- show what changed upstream in the gstack skills that
# ytstack ships as its own adaptations (DECISIONS 2026-11-14).
#
#   bin/ytstack-gstack-diff                 # baseline -> newest gstack tag, full diff
#   bin/ytstack-gstack-diff v1.97.0.0       # baseline -> that tag
#   bin/ytstack-gstack-diff --stat          # file list only
#   bin/ytstack-gstack-diff --source DIR    # use an existing gstack clone (no fetch)
#
# The baseline of each skill is the tag in its `metadata.upstream` line
# ("gstack v1.96.0.0 (...)"). The diff covers the skill's own directory
# (generated *.md, not the *.tmpl sources) plus ETHOS.md and review/, which
# several skills draw on. Without --source the script keeps a clone in
# ${XDG_CACHE_HOME:-$HOME/.cache}/ytstack/gstack and fetches tags; it never
# installs anything and never writes into ~/.claude.
#
# After folding a change into a skill, set its `metadata.upstream` to the new
# tag and commit; AGENTS.md "Skills adapted from gstack" has the procedure.

set -uo pipefail

ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd -P)"
SKILLS="office-hours plan-ceo-review plan-eng-review retro ship document-release"
REPO_URL="https://github.com/garrytan/gstack"

STAT=no; SRC=""; TARGET=""
while [ $# -gt 0 ]; do
  case "$1" in
    --stat) STAT=yes; shift ;;
    --source) SRC="${2:-}"; [ -n "$SRC" ] || { echo "ytstack-gstack-diff: --source needs a directory" >&2; exit 2; }; shift 2 ;;
    -h|--help) sed -n '2,18p' "$0" | sed 's/^# \{0,1\}//'; exit 0 ;;
    v*) TARGET="$1"; shift ;;
    *) echo "ytstack-gstack-diff: unknown argument '$1'" >&2; exit 2 ;;
  esac
done

if [ -z "$SRC" ]; then
  SRC="${XDG_CACHE_HOME:-$HOME/.cache}/ytstack/gstack"
  if [ -d "$SRC/.git" ]; then
    git -C "$SRC" fetch -q --tags origin || { echo "ytstack-gstack-diff: fetch failed in $SRC" >&2; exit 1; }
  else
    mkdir -p "$(dirname "$SRC")" && git clone -q --filter=blob:none --no-checkout "$REPO_URL" "$SRC" \
      || { echo "ytstack-gstack-diff: clone of $REPO_URL failed" >&2; exit 1; }
  fi
fi
git -C "$SRC" rev-parse --git-dir >/dev/null 2>&1 || { echo "ytstack-gstack-diff: $SRC is not a git repository" >&2; exit 2; }

if [ -z "$TARGET" ]; then
  TARGET=$(git -C "$SRC" tag --list 'v*' --sort=-v:refname | head -1)
  [ -n "$TARGET" ] || { echo "ytstack-gstack-diff: no v* tag in $SRC" >&2; exit 1; }
fi
git -C "$SRC" rev-parse -q --verify "$TARGET^{commit}" >/dev/null || { echo "ytstack-gstack-diff: tag $TARGET not found in $SRC" >&2; exit 1; }

echo "gstack upstream: $SRC, target $TARGET"
behind=0
for s in $SKILLS; do
  f="$ROOT/skills/$s/SKILL.md"
  base=$(sed -n 's/^  upstream: *"\{0,1\}gstack \(v[0-9][0-9.]*\).*/\1/p' "$f" 2>/dev/null | head -1)
  if [ -z "$base" ]; then echo "== $s: no metadata.upstream baseline in $f" >&2; behind=1; continue; fi
  if ! git -C "$SRC" rev-parse -q --verify "$base^{commit}" >/dev/null; then echo "== $s: baseline $base not found upstream" >&2; behind=1; continue; fi
  paths=("$s" ETHOS.md review)
  n=$(git -C "$SRC" diff --name-only "$base" "$TARGET" -- "${paths[@]}" ':!*.tmpl' | wc -l | tr -d ' ')
  if [ "$n" = 0 ]; then echo "== $s: $base -> $TARGET, no upstream change"; continue; fi
  behind=1
  echo "== $s: $base -> $TARGET, $n file(s) changed"
  if [ "$STAT" = yes ]; then
    git -C "$SRC" --no-pager diff --stat "$base" "$TARGET" -- "${paths[@]}" ':!*.tmpl'
  else
    git -C "$SRC" --no-pager diff "$base" "$TARGET" -- "${paths[@]}" ':!*.tmpl'
  fi
done
# Exit 3 when at least one skill is behind the target: usable as a release gate.
[ "$behind" = 0 ] || exit 3
exit 0

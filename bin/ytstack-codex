#!/usr/bin/env bash
# Run the existing skill blocks and hooks with their shared environment contract.
set -euo pipefail

export CLAUDE_PLUGIN_ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
PROJECT_DIR=$(git rev-parse --show-toplevel 2>/dev/null) || PROJECT_DIR="$PWD"
export CLAUDE_PROJECT_DIR="$PROJECT_DIR"
cd "$PROJECT_DIR"

usage() {
  echo 'Usage: ytstack-codex skill <name> [bash arguments...] | hook <session-start|pre-compact|session-end>' >&2
  exit 2
}

[ "$#" -ge 2 ] || usage
MODE="$1"
NAME="$2"
shift 2

case "$MODE" in
  skill)
    [[ "$NAME" =~ ^[a-z0-9]+(-[a-z0-9]+)*$ ]] || usage
    export CLAUDE_SKILL_DIR="$CLAUDE_PLUGIN_ROOT/skills/$NAME"
    [ -f "$CLAUDE_SKILL_DIR/SKILL.md" ] || {
      echo "ytstack: skill not found: $NAME" >&2
      exit 2
    }
    exec bash "$@"
    ;;
  hook)
    [ "$#" -eq 0 ] || usage
    case "$NAME" in
      session-start|pre-compact|session-end)
        if [ "$NAME" = session-start ]; then
          export YTSTACK_HOST_CONTEXT="[ytstack plugin root: $CLAUDE_PLUGIN_ROOT]

$(cat "$CLAUDE_PLUGIN_ROOT/codex/adapter.md")"
        fi
        exec bash "$CLAUDE_PLUGIN_ROOT/hooks/$NAME"
        ;;
      *) usage ;;
    esac
    ;;
  *) usage ;;
esac

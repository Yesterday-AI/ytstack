#!/usr/bin/env bash
# ytstack frontier: which lanes may start, and who holds which lane.
# Format: docs/ux/coordinator-format.md ("LANES.md", "Blocking edges and the frontier").
#
#   ytstack-frontier [-C DIR] [list] [--milestone M###] [--ready]
#   ytstack-frontier [-C DIR] claim <lane> --by <worker> [--kind implement|review|prepare] [--branch B] [--worktree W]
#   ytstack-frontier [-C DIR] set <lane> [--status S] [--next TEXT] [--pr N] [--head SHA] [--round N] [--branch B] [--worktree W]
#   ytstack-frontier [-C DIR] release <lane>
#   ytstack-frontier [-C DIR] check [--minutes N]
#   ytstack-frontier [-C DIR] peer set <role> --repo R --address A [--contact UTC]
#   ytstack-frontier [-C DIR] peer list
#
# list     one line per slice of the milestone (default: current_milestone of
#          STATE.md; with "none" the highest M###-ROADMAP.md that is not done,
#          dropped, shipped-informally or backlog): lane, state, detail, tab separated.
#            done     "[x]" in the milestone roadmap, or a merged row in LANES.md
#            claimed  a held row in LANES.md; detail: its "Claimed by" cell
#            blocked  a "**Blocked by:**" entry of the slice plan is not done
#                     (detail: the open ones), or a blocked row in LANES.md,
#                     or an open or asked question that names the lane
#            ready    the rest. A slice without a plan has no edges to read: it
#                     waits for every slice before it; detail "unplanned".
#          After the slices one line per lesson lane, "lesson-F###": an open
#          or planned lesson of the signals ledger whose target is a check
#          (docs/ux/signal-format.md, "Lessons"), unless it is planned with a
#          ref other than "lesson-F###" (a task builds it); detail its key. It is
#          blocked while the lesson has no "## Files" or "## Verification"
#          section. Without a milestone only the lesson lanes are listed.
#          --ready prints the ready lanes only, one per line.
# claim    adds the lane's row to LANES.md (created when missing) with status
#          "claimed". Refused while the row is held, and for a blocked, dropped
#          or merged row until it was released.
# set      changes the named cells of one existing row.
# release  "Claimed by" becomes "-", the status "dropped" unless it is "merged".
# check    LANES.md has the ten columns, unique lanes, listed Status and Kind
#          values, a claim time on every held lane, and four cells in every
#          line under "## Peers". A well-formed file is then read for lanes
#          that stall (issue #84), one "stale: <lane>: ..." line each:
#            a running row whose worktree no longer exists (the worker ended);
#            an implement row whose branch had no commit for --minutes
#            (default 60), counted from the claim when that is newer, or from
#            the start of its fix round when the row carries a PR (the round
#            starts when a check first sees the PR and round in the row);
#            a review or prepare row (they commit nothing) running for 3 x
#            --minutes since its claim;
#            a ready lane of `list` that nobody claimed for --minutes since a
#            check first saw it ready. First sights are kept outside the
#            tree, under a lock: <state base>/repos/<repo key>/frontier-seen.
# peer     the sessions in other repositories this coordinator works with,
#          one line each under "## Peers" in LANES.md:
#            - <role> | <repository> | <address> | <last contact UTC>
#          set adds the line of role and repository or replaces it (the last
#          contact: --contact, else now), list prints them tab separated.
#
# LANES.md lives in the .ytstack directory of DIR (default: $PWD). A write
# changes one row and the "updated:" line, under a lock, through a temporary
# file in the same directory.
#
# Exit codes
#   list     0; with --ready 1 when no lane is ready; 1 no milestone or roadmap
#   claim    0 claimed; 1 refused (says who holds the lane since when)
#   set      0; 1 the lane has no row, or nobody holds it and the status needs a holder
#   release  0; 1 the lane has no row
#   check    0 "lanes ok" or "no lanes file"; 1 one line per problem; 2 the
#            file is well-formed and some lanes are stale
#   peer     0
#   64       usage, or a cell value with "|" or a newline

set -uo pipefail

ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
. "$ROOT/hooks/lib/git-ctx.sh"

COLS='Lane|Kind|Status|Claimed by|Branch|Worktree|PR|Reviewed head|Round|Next action'
# parked (issue #83): its pull request waits open, for a cap or a person.
HELD='claimed|running|reported|in-review|ready|parked'
STATUSES="$HELD|merged|blocked|dropped"
KINDS='implement|review|prepare'
NL='
'

usage() { sed -n '5,11p' "${BASH_SOURCE[0]}" | sed 's/^# \{0,1\}//'; }
die() { echo "ytstack-frontier: $*" >&2; exit 1; }
# listed <value> <a|b|c>
listed() { case "|$2|" in *"|$1|"*) return 0 ;; esac; return 1; }
# has_body FILE NAME: the "## NAME" section exists and holds a non-blank line.
has_body() { awk -v h="## $2" '$0 == h || index($0, h " ") == 1 { f = 1; next } /^## / { f = 0 } f && NF { n = 1 } END { exit !n }' "$1"; }
# cell <value>: refuse what would break the table
cell() {
  case "$1" in *"|"*|*"$NL"*) echo "ytstack-frontier: a cell value must not contain '|' or a newline" >&2; exit 64 ;; esac
}

DIR="$PWD"
if [ "${1:-}" = "-C" ]; then DIR="${2:-}"; shift 2 || true; fi
CMD=list
case "${1:-}" in
  list|claim|set|release|check|peer) CMD=$1; shift ;;
  -h|--help|help) usage; exit 0 ;;
  ""|--*) ;;
  *) usage >&2; exit 64 ;;
esac
# The resolver falls back to $PWD for a missing directory: refuse it here.
[ -d "$DIR" ] || { echo "ytstack-frontier: -C '$DIR' is not a directory" >&2; exit 64; }

yt_git_ctx "$DIR"
yt_resolve_yt_dir >/dev/null
LANES="$YT_DIR/LANES.md"
need_yt() { [ -n "$YT_DIR" ] || die "no .ytstack directory for $DIR"; }

# ---- LANES.md --------------------------------------------------------------------
# lane_rows: the table rows as ten tab separated cells, an empty cell as "-".
lane_rows() {
  [ -f "$LANES" ] || return 0
  awk '
    /^\|/ && ++n > 2 {
      split($0, c, "|"); out = ""
      for (i = 2; i <= 11; i++) { v = c[i]; gsub(/^[ \t]+|[ \t]+$/, "", v); out = out (i > 2 ? "\t" : "") (v == "" ? "-" : v) }
      print out
    }
  ' "$LANES"
}
# get_row <lane>: the lane's cells in R_*; fails when it has no row.
get_row() {
  local row
  R_STATUS=""; R_BY=""; R_NEXT=""
  row=$(lane_rows | YTF_LANE="$1" awk -F'\t' '$1 == ENVIRON["YTF_LANE"] { print; exit }')
  [ -n "$row" ] || return 1
  IFS='	' read -r _ _ R_STATUS R_BY _ _ _ _ _ R_NEXT <<EOF
$row
EOF
}
# table_ok: the first table line is the ten columns, the second a separator.
table_ok() {
  awk -v want="$COLS" '
    /^\|/ {
      if (++n == 1) { h = $0; gsub(/[ \t]*\|[ \t]*/, "|", h); head = (h == "|" want "|") }
      else { sep = ($0 ~ /^\|[ :|-]+$/); exit }
    }
    END { exit !(head && sep) }
  ' "$LANES"
}
# lock: one writer at a time. Two claims sent in the same moment would otherwise
# both read the file without the other's row, and one row would be lost.
# The lock is a file the shell creates itself: under noclobber bash opens it
# with O_EXCL, so exactly one caller gets it. Not `mkdir`: the mkdir of Ubuntu
# 26.04 (uutils coreutils) reports success to several callers that create the
# same directory in the same moment.
# shortcut: a lock left behind by a killed process is not recognised as stale,
# the message names the file to remove; upgrade to a pid check if that ever
# happens in practice.
lock() {
  local n=0
  [ -w "$YT_DIR" ] || die "cannot write in $YT_DIR"
  until ( set -o noclobber; : > "$LANES.lock" ) 2>/dev/null; do
    n=$((n + 1))
    [ "$n" -le 50 ] || die "$LANES.lock exists: another ytstack-frontier is writing. Remove the file if none is."
    sleep 0.1 2>/dev/null || sleep 1
  done
  trap 'rm -f "$LANES.tmp" "$LANES.lock"' EXIT
}
# write <lane> <add|change>: the lane's row from YTF_C1..YTF_C10 (an empty value
# keeps the cell) and the "updated:" line. Every other line is copied as it is.
YTF_C1=""; YTF_C2=""; YTF_C3=""; YTF_C4=""; YTF_C5=""; YTF_C6=""; YTF_C7=""; YTF_C8=""; YTF_C9=""; YTF_C10=""
export YTF_C1 YTF_C2 YTF_C3 YTF_C4 YTF_C5 YTF_C6 YTF_C7 YTF_C8 YTF_C9 YTF_C10
write() {
  YTF_LANE="$1" awk -v mode="$2" -v now="$(date -u +%Y-%m-%dT%H:%M:%SZ)" '
    function trim(s) { gsub(/^[ \t]+|[ \t]+$/, "", s); return s }
    function row(   i, v, out) {
      out = "|"
      for (i = 1; i <= 10; i++) {
        v = ENVIRON["YTF_C" i]
        if (v == "") v = trim(c[i + 1])
        out = out " " (v == "" ? "-" : v) " |"
      }
      return out
    }
    NR == 1 && $0 == "---" { fm = 1; print; next }
    fm && $0 == "---" { if (!stamped) print "updated: " now; fm = 0; print; next }
    fm { if ($0 ~ /^updated:/) { print "updated: " now; stamped = 1 } else print; next }
    /^\|/ {
      split($0, c, "|")
      if (++n > 2 && mode == "change" && !hit && trim(c[2]) == ENVIRON["YTF_LANE"]) { hit = 1; print row() }
      else print
      next
    }
    n >= 2 && mode == "add" && !hit { hit = 1; split("", c); print row() }
    { print }
    END { if (n >= 2 && mode == "add" && !hit) { split("", c); print row() } }
  ' "$LANES" > "$LANES.tmp" && mv "$LANES.tmp" "$LANES" || die "could not write $LANES"
}
# open_table: lock, then make sure there is a table a row can be written to.
open_table() {
  lock
  [ -f "$LANES" ] || return 1
  table_ok || die "$LANES has no lanes table in the documented format; run 'ytstack-frontier check'"
}
# new_table: LANES.md with the empty lanes table (under the lock).
new_table() {
  { printf -- '---\nupdated: -\n---\n\n# Lanes\n\n'
    echo "| $(printf '%s' "$COLS" | sed 's/|/ | /g') |"
    echo '|---|---|---|---|---|---|---|---|---|---|'
  } > "$LANES.tmp" && mv "$LANES.tmp" "$LANES" || die "could not write $LANES"
}
# utc <epoch>: the UTC time to the minute (BSD date, then GNU and BusyBox)
utc() { date -u -r "$1" +%Y-%m-%dT%H:%MZ 2>/dev/null || date -u -d "@$1" +%Y-%m-%dT%H:%MZ; }

# ---- list ------------------------------------------------------------------------
# open_milestone: the highest milestone whose roadmap is still open.
open_milestone() {
  yt_find_artifacts "$YT_DIR" 'M[0-9][0-9][0-9]-ROADMAP.md' | while IFS= read -r f; do
    case "$(sed -n 's/^status:[ ]*\([^ ]*\).*/\1/p' "$f" | head -1)" in
      # backlog: planned, but not to be worked on until it is made current.
      done|dropped|shipped-informally|backlog) ;;
      *) basename "$f" -ROADMAP.md ;;
    esac
  done | sort -r | head -1
}

cmd_list() {
  local m="" ready="" any="" road slices fin=" " earlier="" s x lane state detail plan by b open lessons
  while [ $# -gt 0 ]; do
    case "$1" in
      --ready) ready=1; shift ;;
      --milestone)
        case "${2:-}" in M[0-9][0-9][0-9]) m=$2; shift 2 ;; *) usage >&2; return 64 ;; esac ;;
      *) usage >&2; return 64 ;;
    esac
  done
  need_yt
  lessons=$(lesson_lanes)
  if [ -z "$m" ]; then
    m=$(sed -n 's/^current_milestone:[ ]*\([^ ]*\).*/\1/p' "$YT_DIR/STATE.md" 2>/dev/null | head -1)
    case "$m" in M[0-9][0-9][0-9]) ;; *) m=$(open_milestone) ;; esac
    # Without a milestone the lesson lanes are still work that may start.
    [ -n "$m" ] || [ -n "$lessons" ] || die "no milestone: STATE.md names none and no M###-ROADMAP.md is open"
  fi
  slices=""
  if [ -n "$m" ]; then
    road=$(yt_find_artifacts "$YT_DIR" "$m-ROADMAP.md" | head -1)
    [ -n "$road" ] || die "no roadmap for $m: looked for $YT_DIR/$m-ROADMAP.md"
    # "S01 x" for a checked slice, "S01" for an open one, in roadmap order
    slices=$(awk '/^- \[[ xX]\] S[0-9][0-9]( |$)/ { print substr($0, 7, 3) (substr($0, 4, 1) == " " ? "" : " x") }' "$road")
  fi
  while read -r s x; do
    [ -n "$s" ] || continue
    if [ -n "$x" ] || { get_row "$m-$s" && [ "$R_STATUS" = merged ]; }; then fin="$fin$s "; fi
  done <<EOF
$slices
EOF

  local q qst qid qblock=""
  for q in "$YT_DIR"/questions/Q[0-9]*.md; do
    [ -f "$q" ] || continue
    qst=$(sed -n 's/^state: *//p' "$q" | head -1)
    case "$qst" in open|asked) ;; *) continue ;; esac
    qid=$(sed -n 's/^id: *//p' "$q" | head -1)
    for b in $(sed -n 's/^blocks: *//p' "$q" | head -1 | tr ',' ' '); do qblock="$qblock$NL$b $qid"; done
  done

  while read -r s x; do
    [ -n "$s" ] || continue
    lane="$m-$s"; state=ready; detail=""
    get_row "$lane" || true
    if [ -n "$x" ]; then state="done"
    elif [ "$R_STATUS" = merged ]; then state="done"; detail="merged, roadmap checkbox open"
    elif listed "$R_STATUS" "$HELD"; then state=claimed; detail=$R_BY
    elif [ "$R_STATUS" = blocked ]; then state=blocked; detail="lane: $R_NEXT"
    else
      plan=$(yt_find_artifacts "$YT_DIR" "$lane-PLAN.md" | head -1)
      if [ -n "$plan" ]; then
        # "S01 (needs the schema), S03" names S01 and S03: the first word of each entry
        by=$(sed -n 's/^\*\*Blocked by:\*\*[ ]*//p' "$plan" | head -1 | tr ',' '\n' | awk '{ print $1 }')
      else
        by=$earlier; detail=unplanned
      fi
      open=""
      while IFS= read -r b; do
        b=${b#"$m"-}
        case "$b" in ""|none|-) continue ;; esac
        # An entry that is no done slice of this milestone keeps the lane blocked.
        case "$fin" in *" $b "*) ;; *) open="$open${open:+, }$b" ;; esac
      done <<EOF
$by
EOF
      # A question for the human that names this lane under `blocks:` and is
      # not answered yet blocks it too (docs/ux/coordinator-format.md).
      while read -r b qid; do
        [ -n "$b" ] || continue
        case "$b" in "$lane"|"$s") open="$open${open:+, }question $qid" ;; esac
      done <<EOF
$qblock
EOF
      if [ -n "$open" ]; then state=blocked; detail="$open${detail:+ ($detail)}"; fi
    fi
    earlier="$earlier$NL$s"
    if [ -z "$ready" ]; then printf '%s\t%s%s\n' "$lane" "$state" "${detail:+	$detail}"
    elif [ "$state" = ready ]; then echo "$lane"; any=1
    fi
  done <<EOF
$slices
EOF

  # Lesson lanes: an open lesson whose check is still to be built
  # (docs/ux/signal-format.md, "Lessons"). No edge to a slice; the lesson's
  # "## Files" and "## Verification" are its plan.
  local id key file
  while IFS='	' read -r id key file; do
    [ -n "$id" ] || continue
    lane="lesson-$id"; state=ready; detail=$key
    get_row "$lane" || true
    if [ "$R_STATUS" = merged ]; then state="done"; detail="merged, the lesson is not set fixed yet"
    elif listed "$R_STATUS" "$HELD"; then state=claimed; detail=$R_BY
    elif [ "$R_STATUS" = blocked ]; then state=blocked; detail="lane: $R_NEXT"
    elif ! has_body "$file" Files || ! has_body "$file" Verification; then
      # Empty sections count as missing: ytstack-brief refuses a brief without a scope.
      state=blocked; detail="unplanned: the lesson has no ## Files or no ## Verification with content"
    else
      open=""
      while read -r b qid; do
        [ -n "$b" ] || continue
        [ "$b" != "$lane" ] || open="$open${open:+, }question $qid"
      done <<EOF
$qblock
EOF
      [ -z "$open" ] || { state=blocked; detail=$open; }
    fi
    if [ -z "$ready" ]; then printf '%s\t%s\t%s\n' "$lane" "$state" "$detail"
    elif [ "$state" = ready ]; then echo "$lane"; any=1
    fi
  done <<EOF
$lessons
EOF
  [ -z "$ready" ] || [ -n "$any" ]
}

# lesson_lanes: "<id> <key> <file>" (tab separated) per lesson that is open or
# planned and whose target is a check: the check is still to be built. A
# planned lesson whose ref names something else than its own lane (a task, a
# quick task) is built there, so it is no lane: it would be dispatched twice.
lesson_lanes() {
  local f id key st kind target ref
  [ -d "$YT_DIR/signals" ] || return 0
  for f in "$YT_DIR"/signals/F[0-9][0-9][0-9]-*.md; do
    [ -f "$f" ] || continue
    kind=$(sed -n '2,20{s/^kind:[ ]*//p;}' "$f" | head -1)
    [ "$kind" = lesson ] || continue
    st=$(sed -n '2,20{s/^state:[ ]*//p;}' "$f" | head -1)
    target=$(sed -n '2,20{s/^target:[ ]*//p;}' "$f" | head -1)
    case "$st:$target" in open:check:*|planned:check:*) ;; *) continue ;; esac
    id=$(sed -n '2,20{s/^id:[ ]*//p;}' "$f" | head -1)
    ref=$(sed -n '2,20{s/^ref:[ ]*//p;}' "$f" | head -1)
    if [ "$st" = planned ]; then
      case "$ref" in ""|none|"lesson-$id") ;; *) continue ;; esac
    fi
    key=$(sed -n '2,20{s/^key:[ ]*//p;}' "$f" | head -1)
    printf '%s\t%s\t%s\n' "$id" "$key" "$f"
  done
}

# ---- claim, set, release ---------------------------------------------------------
cmd_claim() {
  local lane="${1:-}" by="" kind="" branch="" wt=""
  case "$lane" in ""|-*) usage >&2; return 64 ;; esac
  cell "$lane"; shift
  while [ $# -gt 0 ]; do
    [ $# -ge 2 ] || { usage >&2; return 64; }
    cell "$2"
    case "$1" in
      --by) by=$2 ;;
      --kind) kind=$2 ;;
      --branch) branch=$2 ;;
      --worktree) wt=$2 ;;
      *) usage >&2; return 64 ;;
    esac
    shift 2
  done
  [ -n "$by" ] && listed "${kind:-implement}" "$KINDS" || { usage >&2; return 64; }
  need_yt
  open_table || new_table
  YTF_C3=claimed; YTF_C4="$by $(date -u +%Y-%m-%dT%H:%MZ)"; YTF_C5=$branch; YTF_C6=$wt
  if get_row "$lane"; then
    if listed "$R_STATUS" "$HELD"; then
      echo "ytstack-frontier: $lane is held by ${R_BY% *} since ${R_BY##* } (status $R_STATUS)" >&2
      return 1
    fi
    if [ "$R_BY" != "-" ]; then
      echo "ytstack-frontier: $lane has a $R_STATUS row of ${R_BY% *}; run 'ytstack-frontier release $lane' before it is claimed again" >&2
      return 1
    fi
    YTF_C2=$kind; YTF_C10=-
    write "$lane" change
  else
    YTF_C1=$lane; YTF_C2=${kind:-implement}; YTF_C9=0
    write "$lane" add
  fi
}

cmd_set() {
  local lane="${1:-}" any="" v
  case "$lane" in ""|-*) usage >&2; return 64 ;; esac
  shift
  while [ $# -gt 0 ]; do
    [ $# -ge 2 ] || { usage >&2; return 64; }
    cell "$2"; v=${2:--}
    case "$1" in
      --status)
        listed "$2" "$STATUSES" || { echo "ytstack-frontier: --status takes one of: $STATUSES" >&2; return 64; }
        YTF_C3=$2 ;;
      --branch) YTF_C5=$v ;;
      --worktree) YTF_C6=$v ;;
      --pr) YTF_C7=$v ;;
      --head) YTF_C8=$v ;;
      --round) YTF_C9=$v ;;
      --next) YTF_C10=$v ;;
      *) usage >&2; return 64 ;;
    esac
    any=1; shift 2
  done
  [ -n "$any" ] || { usage >&2; return 64; }
  need_yt
  open_table && get_row "$lane" || die "$lane has no row in $LANES; claim it first"
  if [ "$R_BY" = "-" ] && listed "$YTF_C3" "$HELD"; then
    die "nobody holds $lane; claim it before it is set to $YTF_C3"
  fi
  write "$lane" change
}

cmd_release() {
  local lane="${1:-}"
  case "$lane" in ""|-*) usage >&2; return 64 ;; esac
  [ $# -eq 1 ] || { usage >&2; return 64; }
  need_yt
  open_table && get_row "$lane" || die "$lane has no row in $LANES"
  YTF_C4=-
  [ "$R_STATUS" = merged ] || YTF_C3=dropped
  write "$lane" change
}

# ---- check -----------------------------------------------------------------------
cmd_check() {
  local min=60 out
  case "$#:${1:-}" in
    0:) ;;
    2:--minutes) case "$2" in ''|*[!0-9]*) usage >&2; return 64 ;; esac; min=$((10#$2)) ;;
    *) usage >&2; return 64 ;;
  esac
  [ -n "$YT_DIR" ] && [ -f "$LANES" ] || { echo "no lanes file"; return 0; }
  awk -v want="$COLS" -v statuses="$STATUSES" -v held="$HELD" -v kinds="$KINDS" '
    function trim(s) { gsub(/^[ \t]+|[ \t]+$/, "", s); return s }
    function listed(v, list) { return index("|" list "|", "|" v "|") > 0 }
    function p(msg) { print msg; bad = 1 }
    $0 == "## Peers" { peers = 1; next }
    peers && /^## / { peers = 0 }
    peers && /^- / {
      if (split($0, c, "|") != 4 || trim(c[4]) !~ /^[0-9][0-9][0-9][0-9]-[0-9][0-9]-[0-9][0-9]T[0-9][0-9]:[0-9][0-9](:[0-9][0-9])?Z$/)
        p("line " NR ": peer line is not \"- <role> | <repository> | <address> | <last contact UTC>\"")
      next
    }
    peers && /^\|/ { p("line " NR ": under ## Peers a peer is a list line \"- <role> | <repository> | <address> | <last contact UTC>\", not a table row"); next }
    !/^\|/ { next }
    ++n == 1 {
      h = $0; gsub(/[ \t]*\|[ \t]*/, "|", h)
      if (h != "|" want "|") p("line " NR ": the header is not the ten columns " want)
      next
    }
    n == 2 { if ($0 !~ /^\|[ :|-]+$/) p("line " NR ": no separator line under the header"); next }
    {
      cells = split($0, c, "|") - 1 - ($0 ~ /\|[ \t]*$/)
      if (cells != 10) { p("line " NR ": " cells " cells, expected 10"); next }
      lane = trim(c[2]); kind = trim(c[3]); st = trim(c[4]); by = trim(c[5])
      if (lane == "") { p("line " NR ": no lane"); next }
      if (seen[lane]++) p(lane ": more than one row")
      if (!listed(kind, kinds)) p(lane ": kind \"" kind "\" is not one of " kinds)
      if (!listed(st, statuses)) p(lane ": status \"" st "\" is not one of " statuses)
      else if (listed(st, held) && by !~ / [0-9][0-9][0-9][0-9]-[0-9][0-9]-[0-9][0-9]T[0-9][0-9]:[0-9][0-9](:[0-9][0-9])?Z$/)
        p(lane ": status " st " without a holder and a claim time (\"" by "\")")
    }
    END {
      if (!n) p("no lanes table")
      exit (bad ? 1 : 0)
    }
  ' "$LANES" || return 1
  out=$(stale "$min")
  [ -n "$out" ] || { echo "lanes ok"; return 0; }
  printf '%s\n' "$out"
  return 2
}

# stale <minutes>: one "stale:" line per lane that stalls (see the header).
# First sights live in <state base>/repos/<key>/frontier-seen, one
# "<key>\t<epoch>" line each: "ready:<lane>" and "fix:<lane>:<round>".
REVIEW_FACTOR=3  # a review or prepare lane commits nothing: it gets 3 x N
stale() {
  local lim=$(($1 * 60)) now top lane kind st by br wt pr rnd t since c f tmp ready keep="" n=0
  now=$(date -u +%s)
  top=${YT_MAIN_TOPLEVEL:-$YT_TOPLEVEL}
  f="$(yt_state_base)/repos/${YT_REPO_KEY:-unknown}/frontier-seen"
  ready=$(cmd_list --ready 2>/dev/null) || ready=""
  # One check at a time reads and rewrites the file (noclobber, not mkdir:
  # .ytstack/KNOWLEDGE.md); without the directory or the lock no first sight
  # is kept, and every lane counts from now.
  SEEN=""; tmp=""; locked=no
  if mkdir -p "${f%/*}" 2>/dev/null; then
    until ( set -o noclobber; : > "$f.lock" ) 2>/dev/null; do
      n=$((n + 1)); [ "$n" -le 50 ] || break
      sleep 0.1 2>/dev/null || sleep 1
    done
    if [ "$n" -le 50 ]; then
      locked=yes; SEEN_LOCK="$f.lock"
      trap 'rm -f "$SEEN_LOCK"' EXIT
      SEEN=$(cat "$f" 2>/dev/null)
      tmp=$(mktemp "$f.XXXXXX" 2>/dev/null) || tmp=""
    fi
  fi
  # seen <key>: SEEN_AT, the first sight of key; kept for the next file
  seen() {
    SEEN_AT=$(printf '%s\n' "$SEEN" | awk -F'\t' -v k="$1" '$1 == k { print $2; exit }')
    case "$SEEN_AT" in ''|*[!0-9]*) SEEN_AT=$now ;; esac
    keep="$keep$1	$SEEN_AT$NL"
  }
  while IFS='	' read -r lane kind st by br wt pr _ rnd _; do
    [ "$st" = running ] || continue
    case "$wt" in /*) c=$wt ;; *) c="$top/$wt" ;; esac
    if [ "$wt" != - ] && [ ! -d "$c" ]; then
      echo "stale: $lane: running, but its worktree $wt does not exist: the worker ended; read its branch and set the status"; continue
    fi
    t=${by##* }; case "$t" in *T[0-9][0-9]:[0-9][0-9]Z) t="${t%Z}:00Z" ;; esac
    since=$(yt_epoch "$t"); [ -n "$since" ] || continue
    if [ "$kind" != implement ]; then
      [ $((now - since)) -gt $((lim * REVIEW_FACTOR)) ] \
        && echo "stale: $lane: running $kind lane, no report for $(((now - since) / 60)) minutes (claimed $(utc "$since"))"
      continue
    fi
    # A PR in the row: a fix round. It starts when a check first sees it.
    if [ "$pr" != - ]; then seen "fix:$lane:$rnd"; [ "$SEEN_AT" -le "$since" ] || since=$SEEN_AT; fi
    c=""
    [ "$br" = - ] || [ "$YT_IS_GIT" != yes ] || c=$(git -C "$YT_TOPLEVEL" log -1 --format=%ct "$br" -- 2>/dev/null)
    [ -z "$c" ] || [ "$c" -le "$since" ] || since=$c
    [ $((now - since)) -gt "$lim" ] || continue
    if [ "$br" = - ]; then echo "stale: $lane: running, no branch in its row, claimed $(((now - since) / 60)) minutes ago"
    else echo "stale: $lane: running, no commit on $br for $(((now - since) / 60)) minutes (since $(utc "$since"))"; fi
  done <<EOF
$(lane_rows)
EOF
  for lane in $ready; do
    seen "ready:$lane"; c=$SEEN_AT
    [ $((now - c)) -le "$lim" ] || echo "stale: $lane: ready, nobody claimed it for $(((now - c) / 60)) minutes (first seen $(utc "$c"))"
  done
  if [ -n "$tmp" ]; then
    { printf '%s' "$keep" > "$tmp" && mv "$tmp" "$f"; } 2>/dev/null || rm -f "$tmp"
    tmp=""
  fi
  [ "$locked" = no ] || rm -f "$f.lock"
}

# ---- peers -----------------------------------------------------------------------
# peer_lines: the lines under "## Peers", four tab separated cells each.
peer_lines() {
  awk '
    $0 == "## Peers" { s = 1; next }
    s && /^## / { exit }
    s && /^- / {
      n = split(substr($0, 3), c, "|"); out = ""
      for (i = 1; i <= n; i++) { gsub(/^[ \t]+|[ \t]+$/, "", c[i]); out = out (i > 1 ? "\t" : "") c[i] }
      print out
    }
  ' "$LANES"
}

cmd_peer() {
  local role repo="" addr="" contact=""
  case "${1:-}" in
    list)
      [ $# -eq 1 ] || { usage >&2; return 64; }
      [ -n "$YT_DIR" ] && [ -f "$LANES" ] || return 0
      peer_lines; return 0 ;;
    set) shift ;;
    *) usage >&2; return 64 ;;
  esac
  role="${1:-}"
  case "$role" in ""|-*) usage >&2; return 64 ;; esac
  cell "$role"; shift
  while [ $# -gt 0 ]; do
    [ $# -ge 2 ] || { usage >&2; return 64; }
    cell "$2"
    case "$1" in
      --repo) repo=$2 ;;
      --address) addr=$2 ;;
      --contact) contact=$2 ;;
      *) usage >&2; return 64 ;;
    esac
    shift 2
  done
  [ -n "$repo" ] && [ -n "$addr" ] || { usage >&2; return 64; }
  [ -n "$contact" ] || contact=$(date -u +%Y-%m-%dT%H:%MZ)
  case "$contact" in
    [0-9][0-9][0-9][0-9]-[0-9][0-9]-[0-9][0-9]T[0-9][0-9]:[0-9][0-9]Z|[0-9][0-9][0-9][0-9]-[0-9][0-9]-[0-9][0-9]T[0-9][0-9]:[0-9][0-9]:[0-9][0-9]Z) ;;
    *) echo "ytstack-frontier: --contact takes a UTC time (YYYY-MM-DDTHH:MMZ)" >&2; return 64 ;;
  esac
  need_yt
  open_table || new_table
  # The line of role and repository is replaced in place, a new one goes after
  # the last peer line; without the section, it is appended to the file.
  YTF_PEER="- $role | $repo | $addr | $contact" YTF_ROLE=$role YTF_REPO=$repo \
    awk -v now="$(date -u +%Y-%m-%dT%H:%M:%SZ)" '
    function trim(s) { gsub(/^[ \t]+|[ \t]+$/, "", s); return s }
    { L[++n] = $0 }
    END {
      for (i = 1; i <= n; i++) {
        if (L[i] == "## Peers") { sec = i; continue }
        if (sec && L[i] ~ /^## /) break
        if (sec && L[i] ~ /^- /) {
          split(substr(L[i], 3), c, "|"); last = i
          if (!hit && trim(c[1]) == ENVIRON["YTF_ROLE"] && trim(c[2]) == ENVIRON["YTF_REPO"]) { L[i] = ENVIRON["YTF_PEER"]; hit = 1 }
        }
      }
      for (i = 1; i <= n; i++) {
        if (i == 1 && L[i] == "---") { fm = 1; print L[i]; continue }
        if (fm && L[i] == "---") { if (!stamped) print "updated: " now; fm = 0; print L[i]; continue }
        if (fm && L[i] ~ /^updated:/) { print "updated: " now; stamped = 1; continue }
        print L[i]
        if (!hit && sec && i == (last ? last : sec)) { if (!last) print ""; print ENVIRON["YTF_PEER"] }
      }
      if (!sec) { print ""; print "## Peers"; print ""; print ENVIRON["YTF_PEER"] }
    }
  ' "$LANES" > "$LANES.tmp" && mv "$LANES.tmp" "$LANES" || die "could not write $LANES"
}

case "$CMD" in
  list)    cmd_list "$@" ;;
  claim)   cmd_claim "$@" ;;
  set)     cmd_set "$@" ;;
  release) cmd_release "$@" ;;
  check)   cmd_check "$@" ;;
  peer)    cmd_peer "$@" ;;
esac

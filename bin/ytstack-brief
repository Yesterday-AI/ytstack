#!/usr/bin/env bash
# ytstack brief: the prompt a dispatched worker gets, and the check of its report.
#
#   ytstack-brief [-C DIR] render --task M###-S##-T## [--kind KIND] [--branch NAME] [--base NAME]
#   ytstack-brief [-C DIR] render --slice M###-S##   [--kind KIND] [--branch NAME] [--base NAME]
#   ytstack-brief [-C DIR] render --task|--slice REF --kind review --head SHA [--base SHA] [--lens NAME]
#   ytstack-brief check [FILE]             validate a worker's report (FILE or stdin)
#
# render prints one Markdown brief on stdout, built from the plan files under
# the .ytstack directory of DIR (default: $PWD): outcome, kind, scope, what to
# read, verification, spec impact, gates, the Git instructions (only with
# --branch; --base defaults to the current branch of DIR), the work contract
# and the report shape. The work contract is the body of
# skills/minimal-code/SKILL.md, read at render time; its text lives nowhere
# else. Skeleton, fixed sentences and the report shape:
# skills/spawn-milestone-team/brief-template.md.
#
# KIND says what the worker may do (docs/ux/coordinator-format.md, "Lane kinds"):
#   implement  (default) change files inside the scope, commit with the prefix
#   review     read only: review the range --base..--head, or the commit --head
#              without --base. Both are commit hashes, a name would pin
#              nothing. No Git section, --branch is ignored. The reviewer is
#              asked for a verdict and for the class of the change: the four
#              labels Risk, Severity, Reach and Invariants touched
#              (docs/ux/review-policy-format.md, "Records").
#              With --lens NAME the brief is the one of a lens, a second review
#              with one question ("Lenses" in the same document): a section
#              "Lens" with the lens line of .ytstack/spec/REVIEW.md, its reads
#              documents, the rules of every lens and, for "evidence: visual",
#              the evidence rules, where the images go and the instruction to
#              load ytstack:visual-review. The lens is read from the REVIEW.md
#              of the commit --head. Its report carries "Lens:" and
#              "Evidence:" and no class.
#   prepare    write files inside the scope, commit nothing
#
# check validates the eleven labels of the template's "Report" section: each
# present at the start of a line and with a value, an exit code in every
# "Checks run:" line, "Status:" one of complete, partial, blocked, and
# consistent with "Blockers:" (blocked names one, complete has none). A report
# that carries one of the four labels of a review (Risk, Severity, Reach,
# Invariants touched) has to carry all four with a value, and "Risk:" is low,
# normal or high. A report that carries "Lens:" or "Evidence:" has to carry
# both: "Lens: <name> -- pass | fail | not run", and "Evidence: none" or
# "Evidence: <directory> (<n> images)".
#
# Exit codes
#   render  0 brief printed; 1 no plan, no scope, no contract or no template,
#           or a lens that cannot run: not defined at --head, or one of its
#           reads documents is not there (no brief is printed); 64 usage
#   check   0 "report ok"; 1 one line per problem; 64 usage

set -uo pipefail

ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
TPL="$ROOT/skills/spawn-milestone-team/brief-template.md"
CONTRACT="$ROOT/skills/minimal-code/SKILL.md"
NL='
'

DIR="$PWD"
if [ "${1:-}" = "-C" ]; then DIR="${2:-}"; shift 2 || true; fi
CMD="${1:-}"; [ $# -gt 0 ] && shift

usage() { sed -n '2,7p' "${BASH_SOURCE[0]}" | sed 's/^# \{0,1\}//'; }
die() { echo "ytstack-brief: $*" >&2; exit 1; }

# section <file> <heading>: body of "## <heading>" without the blank lines
# around it. A "## " line inside a code fence does not end the section.
section() {
  awk -v h="## $2" '
    /^```/ { fence = !fence }
    !fence && /^## / { t = $0; sub(/[ \t]+$/, "", t); on = (t == h); next }
    on && (NF || body) { print; body = 1 }
  ' "$1"
}
# field <file> <label>: the text after the first "**<label>:**"
field() { sed -n "s/^\*\*$2:\*\*[ ]*//p" "$1" | head -1; }
# snip <name>: the fixed sentences of that name from the template
# ("<!-- name: text -->"), one per line
snip() { sed -n "s/^<!-- $1: \(.*\) -->\$/\1/p" "$TPL"; }
# is_sha <text>: seven or more hex digits
is_sha() { case "$1" in *[!0-9a-fA-F]*) return 1 ;; esac; [ ${#1} -ge 7 ]; }
# para <a> <b>: both, with a blank line between them when both have text
para() { printf '%s' "$1${1:+${2:+$NL$NL}}$2"; }
rel() { case "$1" in "$TOP"/*) printf '%s' "${1#"$TOP"/}" ;; *) printf '%s' "$1" ;; esac; }
find_plan() { yt_find_artifacts "${YT_DIR:-}" "$1-PLAN.md" | head -1; }

# add <label> <plan>: one plan's files, verification, spec impact and gates,
# appended to the B_* values. The label ("T01") is empty for a single task.
add() {
  local l="${1:+**$1**$NL$NL}" x
  x=$(section "$2" Files)
  [ -n "$x" ] || die "no '## Files' section in $(rel "$2"); a brief without a scope must not be produced"
  PLANS="$PLANS$NL$2"; ALL_FILES="$ALL_FILES$NL$x"
  B_FILES=$(para "$B_FILES" "$l$x")
  x=$(section "$2" Verification);  B_VERIFICATION=$(para "$B_VERIFICATION" "$l${x:-$(snip no-verification)}")
  x=$(section "$2" "Spec impact"); B_SPEC_IMPACT=$(para "$B_SPEC_IMPACT" "$l${x:-$(snip no-spec-impact)}")
  x=$(section "$2" Gates);         [ -z "$x" ] || B_GATES=$(para "$B_GATES" "$l$x")
}

# ---- the lens of a review ------------------------------------------------------
# lens_def <name>: REVIEW.md on stdin; the lens of that name as four lines: its
# line, its reads (comma separated), its evidence, its skill. Nothing when the
# file defines no such lens. A line is read the way review_parse in
# bin/ytstack-risk reads it: keep the two in step.
lens_def() {
  awk -v want="$1" '
    function trim(s) { sub(/^[ \t]+/, "", s); sub(/[ \t\r]+$/, "", s); return s }
    /^```/ { fence = !fence; next }
    fence { next }
    /^## / { on = (trim(substr($0, 4)) == "Lenses"); next }
    !on || !/^[ \t]*-[ \t]+/ { next }
    {
      item = $0; sub(/^[ \t]*-[ \t]+/, "", item); item = trim(item)
      n = split(item, part, "|")
      if (trim(part[1]) != want) next
      reads = ""; ev = ""; skill = ""
      for (i = 2; i <= n; i++) {
        p = trim(part[i]); k = p; sub(/:.*/, "", k); v = trim(substr(p, length(k) + 2))
        if (k == "reads") reads = v; else if (k == "evidence") ev = v; else if (k == "skill") skill = v
      }
      print item; print reads; print ev; print skill; exit
    }
  '
}

# lens_snip <name>: the fixed sentences of that name; no brief without them.
lens_snip() {
  local s; s=$(snip "$1")
  [ -n "$s" ] || die "the brief template $TPL has no '$1' sentences; a lens brief without them must not be produced"
  printf '%s' "$s"
}

# lens_section <name> <head> <ref>: sets B_LENS, the "Lens" section of a review
# brief, from the REVIEW.md of the reviewed commit. Ends without a brief when
# the lens cannot run: the commit is not in this repository, the policy
# defines no such lens, or one of its reads documents is not at that commit.
lens_section() {
  local name="$1" head="$2" ref="$3" full def line reads ev skill doc docs="" x m
  full=$(git -C "$TOP" rev-parse --verify --quiet "$head^{commit}" 2>/dev/null) \
    || die "--head '$head' is no commit of $TOP; the lens $name is read from the REVIEW.md of the reviewed commit"
  def=$(git -C "$TOP" show "$full:.ytstack/spec/REVIEW.md" 2>/dev/null | lens_def "$name")
  [ -n "$def" ] || die "no lens '$name' in .ytstack/spec/REVIEW.md at ${full:0:7}; a brief for a lens the project does not define must not be produced"
  { IFS= read -r line; IFS= read -r reads; IFS= read -r ev; IFS= read -r skill; } <<EOF
$def
EOF
  case "$ev" in visual|none) ;; *) die "lens $name: evidence '$ev' is not visual or none" ;; esac
  while IFS= read -r doc; do
    [ -n "$doc" ] || continue
    git -C "$TOP" cat-file -e "$full:$doc" 2>/dev/null \
      || die "lens $name reads $doc, which does not exist at ${full:0:7}: the lens cannot run"
    docs="$docs${docs:+$NL}- \`$doc\`"
  done <<EOF
$(printf '%s\n' "$reads" | tr ',' '\n' | sed 's/^[[:space:]]*//; s/[[:space:]]*$//')
EOF
  [ -n "$docs" ] || die "lens $name has no reads document: there is nothing to review against"

  # The inserted values are paths and names from the project: the replacement
  # is quoted, because bash 5.2 and later read a bare "&" in it as the match.
  m='{{LENS_NAME}}'; x=$(lens_snip lens-intro) || exit 1
  x=${x//"$m"/"$name"}; B_LENS="$x$NL$NL    - $line$NL$NL"
  x=$(lens_snip lens-reads) || exit 1;  B_LENS="$B_LENS$x$NL$NL$docs$NL$NL"
  x=$(lens_snip lens-rules) || exit 1;  B_LENS="$B_LENS$x$NL$NL"
  x=$(lens_snip "lens-$ev") || exit 1
  if [ "$ev" = visual ]; then
    yt_prefs "$YT_DIR"
    m='{{EVIDENCE}}';      x=${x//"$m"/"$YT_PREF_EVIDENCE_DIR/$ref/${full:0:7}/$name"}
    m='{{EVIDENCE_ROOT}}'; x=${x//"$m"/"${YT_MAIN_TOPLEVEL:-$TOP}"}
    m='{{SKILL_FILE}}';    x=${x//"$m"/"$ROOT/skills/visual-review/SKILL.md"}
  fi
  B_LENS="$B_LENS$x$NL$NL"
  if [ -n "$skill" ]; then
    m='{{LENS_SKILL}}'; x=$(lens_snip lens-skill) || exit 1
    x=${x//"$m"/"$skill"}; B_LENS="$B_LENS$x$NL$NL"
  fi
  m='{{LENS_NAME}}'; x=$(lens_snip lens-report) || exit 1
  x=${x//"$m"/"$name"}; B_LENS="$B_LENS$x"
}

# ---- render --------------------------------------------------------------------
cmd_render() {
  local kind="" ref="" branch="" base="" lane=implement head="" lens="" plan ids t tp x m
  while [ $# -gt 0 ]; do
    [ $# -ge 2 ] || { usage >&2; return 64; }
    case "$1" in
      --task|--slice) kind=${1#--}; ref=$2 ;;
      --kind) lane=$2 ;;
      --branch) branch=$2 ;;
      --base) base=$2 ;;
      --head) head=$2 ;;
      --lens) lens=$2
        case "$lens" in ""|[!a-z0-9]*|*[!a-z0-9-]*) echo "ytstack-brief: --lens '$lens' is not a lens name (a lowercase slug)" >&2; return 64 ;; esac ;;
      *) usage >&2; return 64 ;;
    esac
    shift 2
  done
  case "$kind:$ref" in
    task:M[0-9][0-9][0-9]-S[0-9][0-9]-T[0-9][0-9]|slice:M[0-9][0-9][0-9]-S[0-9][0-9]) ;;
    *) usage >&2; return 64 ;;
  esac
  case "$lane" in
    implement|prepare)
      # --head without "--kind review" would hand a reviewer a brief that lets it change files.
      [ -z "$head" ] && [ -z "$lens" ] || { usage >&2; return 64; } ;;
    review)
      [ -n "$head" ] || { usage >&2; return 64; }
      for x in "--head:$head" ${base:+"--base:$base"}; do
        is_sha "${x#*:}" || { echo "ytstack-brief: ${x%%:*} '${x#*:}' is not a commit hash (seven or more hex digits); a branch or tag name pins nothing" >&2; return 64; }
      done ;;
    *) usage >&2; return 64 ;;
  esac
  # The resolver falls back to $PWD for a missing directory: refuse it here.
  [ -d "$DIR" ] || { echo "ytstack-brief: -C '$DIR' is not a directory" >&2; return 64; }
  [ -f "$CONTRACT" ] || die "the work contract $CONTRACT is missing; a brief without it must not be produced"
  [ -f "$TPL" ] || die "the brief template $TPL is missing"

  . "$ROOT/hooks/lib/git-ctx.sh"
  yt_git_ctx "$DIR"
  yt_resolve_yt_dir >/dev/null
  TOP="$YT_TOPLEVEL"
  plan=$(find_plan "$ref")
  [ -n "$plan" ] || die "no plan for $ref: looked for ${YT_DIR:-$TOP/.ytstack}/$ref-PLAN.md"

  PLANS="$plan"; ALL_FILES=""
  B_REF="$ref"; B_COMMIT_PREFIX="$ref"
  B_OUTCOME=""; B_FILES=""; B_VERIFICATION=""; B_SPEC_IMPACT=""; B_GATES=""; B_BRANCH=""; B_BASE=""
  B_KIND=""; B_COMMIT_RULE=""; B_LENS=""
  [ -z "$lens" ] || lens_section "$lens" "$head" "$ref"

  if [ "$kind" = task ]; then
    B_OUTCOME=$(para "$(field "$plan" Summary)" "$(section "$plan" "What this does")")
    add "" "$plan"
  else
    B_COMMIT_PREFIX="$ref-T##"
    B_OUTCOME=$(para "$(field "$plan" Goal)" "$(section "$plan" Tasks)")
    if [ -n "$(section "$plan" Files)" ]; then
      # granularity: slice -- the slice plan is the one plan, there are no T## plans
      B_OUTCOME=$(para "$B_OUTCOME" "$(section "$plan" "What this does")")
      add "" "$plan"
    else
      B_GATES=$(section "$plan" Gates)
      ids=$(section "$plan" Tasks | sed -n 's/^- \[[ xX]\] \(T[0-9][0-9]\) .*/\1/p')
      [ -n "$ids" ] || die "no tasks in $(rel "$plan"): expected '- [ ] T## -- <text>' under '## Tasks'"
      for t in $ids; do
        tp=$(find_plan "$ref-$t")
        if [ -n "$tp" ]; then add "$t" "$tp"; continue; fi
        B_FILES=$(para "$B_FILES" "**$t** -- $(snip unplanned)")
        B_VERIFICATION=$(para "$B_VERIFICATION" "**$t** -- $(snip unplanned-part)")
        B_SPEC_IMPACT=$(para "$B_SPEC_IMPACT" "**$t** -- $(snip unplanned-part)")
      done
    fi
  fi
  [ -n "$B_OUTCOME" ] || die "no outcome in $(rel "$plan"): expected '**Summary:**' or '**Goal:**'"

  B_PROJECT=$(awk '
    NR == 1 { if ($0 != "---") exit; next }
    $0 == "---" { exit }
    sub(/^name:[ \t]*/, "") { gsub(/^["'\'']|["'\'']$/, ""); print; exit }
  ' "$YT_DIR/PROJECT.md" 2>/dev/null)
  B_PROJECT=${B_PROJECT:-$(basename "$TOP")}

  B_CONTEXT=$(printf '%s\n' "$PLANS" | awk 'NF && !seen[$0]++' | while IFS= read -r x; do
    printf -- '- `%s`\n' "$(rel "$x")"
  done)
  if [ -f "$YT_DIR/spec/SPEC.md" ]; then
    B_CONTEXT="$B_CONTEXT$NL- \`$(rel "$YT_DIR/spec/SPEC.md")\`"
    # The planned paths: what the Files sections name in backticks (spaces
    # included), without a ":12-40" line range.
    set --
    while IFS= read -r x; do [ -z "$x" ] || set -- "$@" "$x"; done <<EOF
$(printf '%s\n' "$ALL_FILES" | grep -oE '`[^`]+`' | tr -d '`' | sed 's/:[0-9][0-9,-]*$//' | sort -u)
EOF
    if [ $# -gt 0 ] && [ -f "$ROOT/bin/ytstack-spec" ]; then
      for x in $(bash "$ROOT/bin/ytstack-spec" -C "$DIR" areas --names "$@"); do
        B_CONTEXT="$B_CONTEXT$NL- \`$(rel "$YT_DIR/spec/$x.md")\`"
      done
    fi
  elif [ -f "$YT_DIR/KNOWLEDGE.md" ]; then
    # No technical spec: the conventions and gotchas are the nearest thing to it.
    B_CONTEXT="$B_CONTEXT$NL- \`$(rel "$YT_DIR/KNOWLEDGE.md")\`"
  fi

  # What the worker may do: the kind's fixed sentences, then its commit rule,
  # which the Git section repeats. The inserted values are a validated
  # reference and hex digits, so no character of them is special to the
  # substitution.
  m='{{COMMIT_PREFIX}}'; x=$(snip "commit-$lane"); B_COMMIT_RULE=${x//"$m"/$B_COMMIT_PREFIX}
  if [ -n "$base" ]; then x="the range \`$base..$head\`"; else x="the commit \`$head\`"; fi
  m='{{RANGE}}'; B_KIND=$(snip "kind-$lane"); B_KIND=${B_KIND//"$m"/$x}
  [ -n "$B_KIND" ] || die "the brief template $TPL has no 'kind-$lane' sentences; a brief that does not say what the worker may do must not be produced"
  if [ "$lane" = review ] && [ -n "$lens" ]; then
    # A lens answers one question with pass, fail or not run; it states no class.
    x=$(lens_snip lens-kind) || exit 1
    B_KIND="$B_KIND$NL$x"
  elif [ "$lane" = review ]; then
    # A review states a verdict and the class of the change it looked at.
    x=$(snip round-review)
    [ -n "$x" ] || die "the brief template $TPL has no 'round-review' sentences; a review brief that does not ask for the class of the change must not be produced"
    B_KIND="$B_KIND$NL$x"
  fi
  B_KIND="$B_KIND${B_COMMIT_RULE:+$NL$B_COMMIT_RULE}"

  # A review changes nothing: it gets no Git section, and --base is the start of its range.
  if [ -n "$branch" ] && [ "$lane" != review ]; then
    [ -n "$base" ] || base=$(git -C "$TOP" branch --show-current 2>/dev/null)
    [ -n "$base" ] || die "--base is needed: $TOP has no current branch"
    B_BRANCH="$branch"; B_BASE="$base"
  fi

  # The contract: everything after the frontmatter, headings two levels down
  # so that they sit under the brief's "## Work contract".
  B_CONTRACT=$(awk '
    NR == 1 && $0 == "---" { fm = 1; next }
    fm { if ($0 == "---") fm = 0; next }
    /^```/ { fence = !fence }
    !fence && /^#+ / { $0 = "##" $0 }
    NF || body { print; body = 1 }
  ' "$CONTRACT")
  [ -n "$B_CONTRACT" ] || die "the work contract $CONTRACT has no body; a brief without it must not be produced"

  # Fill the template. Values are inserted as literal text (no regex
  # replacement, so "&", "/", backticks and "$" survive) and are not scanned
  # again. A "## " section with an empty marker is left out (Gates, Git).
  # shortcut: values travel through the environment, so one value is limited to
  # what the OS allows per variable (about 128 KB on Linux); upgrade to
  # temporary files if a plan section ever gets that long.
  export B_REF B_PROJECT B_OUTCOME B_KIND B_LENS B_FILES B_CONTEXT B_VERIFICATION B_SPEC_IMPACT B_GATES B_BRANCH B_BASE B_COMMIT_RULE B_CONTRACT
  awk '
    function flush() { if (!drop) printf "%s", buf; buf = ""; drop = 0 }
    /^<!--/ { next }
    /^## / { flush() }
    {
      line = $0; out = ""
      while (match(line, /[{][{][A-Z_]+[}][}]/)) {
        val = ENVIRON["B_" substr(line, RSTART + 2, RLENGTH - 4)]
        if (val == "") drop = 1
        out = out substr(line, 1, RSTART - 1) val
        line = substr(line, RSTART + RLENGTH)
      }
      buf = buf out line "\n"
    }
    END { flush() }
  ' "$TPL"
}

# ---- check ---------------------------------------------------------------------
# A label counts at the start of a line, inside a code fence or not. Its value
# is the rest of that line plus the lines that follow, up to a blank line, a
# fence or the next label ("Commits:" is often a list).
cmd_check() {
  [ $# -le 1 ] || { usage >&2; return 64; }
  if [ $# -eq 1 ]; then
    [ -r "$1" ] && [ ! -d "$1" ] || { echo "ytstack-brief: cannot read report '$1'" >&2; return 64; }
    exec < "$1"
  fi
  awk '
    BEGIN {
      n = split("Task|Status|Outcome|Commits|Uncommitted|Checks run|Spec|Deviations|Blockers|Not checked|Next", L, "|")
      # What a review (four) and a lens (two) add after the eleven; read as
      # labels, required only together.
      all = n + split("Risk|Severity|Reach|Invariants touched|Lens|Evidence", X, "|")
      for (i = n + 1; i <= all; i++) L[i] = X[i - n]
    }
    function done(   v) {
      if (!cur) return
      v = val; gsub(/^[ \t]+|[ \t]+$/, "", v)
      V[L[cur]] = v
      if (v == "") empty[cur] = 1
      else if (L[cur] == "Checks run" && v !~ /exit [0-9]+/ && v !~ /^none/) nocode[++nc] = v
      cur = 0
    }
    {
      for (i = 1; i <= all; i++) if (index($0, L[i] ":") == 1) {
        done(); cur = i; seen[i] = 1; val = substr($0, length(L[i]) + 2); next
      }
      if ($0 ~ /^[ \t]*$/ || $0 ~ /^[ \t]*```/) done()
      else if (cur) val = val " " $0
    }
    END {
      done()
      for (i = 1; i <= n; i++) {
        if (!seen[i]) { print "missing: " L[i]; bad = 1 }
        else if (empty[i]) { print "empty: " L[i]; bad = 1 }
      }
      for (i = 1; i <= nc; i++) { print "Checks run: no exit code in \"" nocode[i] "\""; bad = 1 }
      s = V["Status"]; b = V["Blockers"]
      if (s != "" && s !~ /^(complete|partial|blocked)$/) { print "Status: \"" s "\" is not complete, partial or blocked"; bad = 1 }
      if (b != "") {
        none = (b ~ /^[Nn]one[.]?$/)
        if (s == "blocked" && none) { print "Status: blocked needs a Blockers: value other than \"none\""; bad = 1 }
        if (s == "complete" && !none) { print "Status: complete needs \"Blockers: none\""; bad = 1 }
      }
      # The class of a change: four labels that stand together.
      for (i = n + 1; i <= n + 4; i++) if (seen[i]) risk = 1
      if (risk) {
        for (i = n + 1; i <= n + 4; i++) {
          if (!seen[i]) { print "missing: " L[i]; bad = 1 }
          else if (empty[i]) { print "empty: " L[i]; bad = 1 }
        }
        r = V["Risk"]
        if (r != "" && r !~ /^(low|normal|high)$/) { print "Risk: \"" r "\" is not low, normal or high"; bad = 1 }
      }
      # The verdict of a lens and its evidence.
      if (seen[n + 5] || seen[n + 6]) {
        for (i = n + 5; i <= n + 6; i++) {
          if (!seen[i]) { print "missing: " L[i]; bad = 1 }
          else if (empty[i]) { print "empty: " L[i]; bad = 1 }
        }
        l = V["Lens"]; e = V["Evidence"]
        if (l != "" && l !~ /^[a-z0-9][a-z0-9-]* -- (pass|fail|not run)$/) { print "Lens: \"" l "\" is not \"<name> -- pass\", \"<name> -- fail\" or \"<name> -- not run\""; bad = 1 }
        if (e != "" && e != "none" && e !~ / \([0-9]+ images?\)$/) { print "Evidence: \"" e "\" is neither \"none\" nor \"<directory> (<n> images)\""; bad = 1 }
      }
      if (bad) exit 1
      print "report ok"
    }
  '
}

case "$CMD" in
  render) cmd_render "$@" ;;
  check)  cmd_check "$@" ;;
  -h|--help|help) usage ;;
  *) usage >&2; exit 64 ;;
esac
